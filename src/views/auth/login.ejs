<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title != 'undefined' ? title : 'Login - ZenithPrime' %></title>
    <link rel="icon" type="image/png" href="/images/ZenithPrimeLogoTransparant.png">
    <link rel="apple-touch-icon" href="/images/ZenithPrimeLogoTransparant.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Poppins', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
            background-color: #0f172a; /* Fallback color */
        }
        
        #bgVideo {
            position: fixed;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            z-index: -2;
            transform: translateX(-50%) translateY(-50%);
            object-fit: cover;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(3, 7, 18, 0.75); /* Slate 950 opacity */
            z-index: -1;
        }
        
        .form-card {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center">

    <video autoplay muted loop playsinline id="bgVideo">
        <source src="/images/bgAuth.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
    <div class="video-overlay"></div>

    <div class="w-full max-w-4xl p-4">
        <div class="form-card rounded-2xl flex overflow-hidden w-full animate-fade-in-up">
            
            <div class="hidden md:flex w-1/2 flex-col items-center justify-center bg-slate-900/40 p-12 border-r border-slate-500/20 relative">
                <div class="absolute w-32 h-32 bg-cyan-500/20 rounded-full blur-3xl"></div>
                
                <img src="/images/ZenithPrimeLogo.png" 
                     onerror="this.src='https://placehold.co/200x200/0f172a/06b6d4?text=Z'"
                     alt="ZenithPrime Logo" 
                     class="w-40 h-40 object-cover rounded-full shadow-2xl border-2 border-cyan-400/50 relative z-10">
                
                <h1 class="text-4xl font-bold text-white mt-6 drop-shadow-lg tracking-tight relative z-10">
                    Zenith<span class="text-cyan-400">Prime</span>
                </h1>
                <p class="text-cyan-300/80 mt-2 text-sm tracking-widest uppercase relative z-10">Ascend to Prime.</p>
            </div>

            <div class="w-full md:w-1/2 p-8 md:p-12 text-white bg-transparent">
                <div class="text-center md:text-left mb-8">
                    <h2 class="text-3xl font-bold text-white mb-2">Sign In</h2>
                    <p class="text-slate-400 text-sm">Welcome back, player. Access terminal ready.</p>
                </div>
                
                <% if (error_msg && error_msg.length > 0) { %>
                    <div class="mb-6 flex items-center p-4 mb-4 text-sm text-red-200 border border-red-500/50 rounded-lg bg-red-900/40" role="alert">
                        <svg class="flex-shrink-0 inline w-4 h-4 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
                        </svg>
                        <span class="sr-only">Info</span>
                        <div><%= error_msg %></div>
                    </div>
                <% } %>

                <% if (success_msg && success_msg.length > 0) { %>
                    <div class="mb-6 flex items-center p-4 mb-4 text-sm text-green-200 border border-green-500/50 rounded-lg bg-green-900/40" role="alert">
                        <svg class="flex-shrink-0 inline w-4 h-4 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
                        </svg>
                        <div><%= success_msg %></div>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST" class="space-y-5">
                    
                    <div class="relative group">
                        <input type="text" name="identifier" required
                            class="w-full pl-4 pr-4 py-3 bg-slate-900/50 border border-slate-700 text-white rounded-lg focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all placeholder:text-slate-500"
                            placeholder="Email or WhatsApp Number">
                    </div>

                    <div class="relative group">
                        <input type="password" name="password" required
                            class="w-full pl-4 pr-4 py-3 bg-slate-900/50 border border-slate-700 text-white rounded-lg focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all placeholder:text-slate-500"
                            placeholder="Password">
                    </div>

                    <div class="flex justify-end">
                        <a href="/auth/forgot-password" class="text-xs text-cyan-400 hover:text-cyan-300 font-semibold transition hover:underline">
                            Lupa Password?
                        </a>
                    </div>

                    <button type="submit"
                            class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold tracking-wider py-3.5 rounded-lg shadow-lg shadow-cyan-500/20 transition-all duration-300 transform hover:-translate-y-0.5 mt-2 border border-white/10">
                        LOGIN SYSTEM
                    </button>
                </form>

                <div class="mt-8 text-center text-slate-400 text-sm">
                    <p>
                        Need an account?
                        <a href="/auth/register" class="text-cyan-400 hover:text-cyan-300 font-bold transition ml-1 hover:underline">Register Now</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

</body>
</html>