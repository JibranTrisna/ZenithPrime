<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title != 'undefined' ? title : 'Buat Password Baru - ZenithPrime' %></title>
    <link rel="icon" type="image/png" href="/images/ZenithPrimeLogoTransparant.png">
    <link rel="apple-touch-icon" href="/images/ZenithPrimeLogoTransparant.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Poppins', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
            background-color: #0f172a;
        }
        
        #bgVideo {
            position: fixed;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            z-index: -2;
            transform: translateX(-50%) translateY(-50%);
            object-fit: cover;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(3, 7, 18, 0.75);
            z-index: -1;
        }
        
        .form-card {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <video autoplay muted loop playsinline id="bgVideo">
        <source src="/images/bgAuth.mp4" type="video/mp4">
    </video>
    <div class="video-overlay"></div>

    <div class="w-full max-w-lg animate-fade-in-up">
        <div class="form-card rounded-2xl p-8 md:p-10 border border-white/10 text-white relative overflow-hidden">
            
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="text-center mb-8">
                <a href="/" class="inline-flex items-center gap-3 mb-5 group">
                    <img src="/images/ZenithPrimeLogo.png" alt="ZenithPrime Logo" class="w-12 h-12 object-contain rounded-xl shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform">
                    <span class="text-2xl font-extrabold text-white tracking-tight">Zenith<span class="text-cyan-400">Prime</span></span>
                </a>
                <div class="flex justify-center mb-3">
                    <div class="inline-flex p-2.5 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 shadow-inner">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                </div>
                <h1 class="text-2xl font-extrabold text-white tracking-tight">Set Password Baru</h1>
                <p class="text-slate-400 text-sm mt-2">
                    Akun: <span class="text-cyan-400 font-mono"><%= typeof email != 'undefined' ? email : '' %></span>
                </p>
            </div>

            <% if (typeof error_msg != 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="mb-6 flex items-center p-4 text-sm text-red-200 border border-red-500/50 rounded-lg bg-red-900/40" role="alert">
                    <svg class="flex-shrink-0 inline w-4 h-4 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
                    </svg>
                    <div><%= error_msg %></div>
                </div>
            <% } %>

            <form action="/auth/reset-password/<%= token %>" method="POST" class="space-y-5">
                <div class="relative group">
                    <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Password Baru</label>
                    <input type="password" name="password" required minlength="6"
                        class="w-full px-4 py-3 bg-slate-900/60 border border-slate-700 text-white rounded-lg focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all placeholder:text-slate-500"
                        placeholder="Minimal 6 karakter">
                </div>

                <div class="relative group">
                    <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Konfirmasi Password Baru</label>
                    <input type="password" name="confirmPassword" required minlength="6"
                        class="w-full px-4 py-3 bg-slate-900/60 border border-slate-700 text-white rounded-lg focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all placeholder:text-slate-500"
                        placeholder="Ulangi password baru">
                </div>

                <button type="submit"
                        class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold tracking-wider py-3.5 rounded-lg shadow-lg shadow-cyan-500/20 transition-all duration-300 transform hover:-translate-y-0.5 mt-2 border border-white/10">
                    SIMPAN PASSWORD BARU
                </button>
            </form>

            <div class="mt-8 text-center text-slate-400 text-sm">
                <a href="/auth/login" class="text-cyan-400 hover:text-cyan-300 font-bold transition hover:underline">
                    ← Batalkan & Kembali ke Login
                </a>
            </div>

        </div>
    </div>

</body>
</html>
