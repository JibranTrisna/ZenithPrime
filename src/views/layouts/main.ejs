<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title : 'ZenithPrime' %></title>
    <link rel="icon" type="image/png" href="/images/ZenithPrimeLogoTransparant.png">
    <link rel="apple-touch-icon" href="/images/ZenithPrimeLogoTransparant.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <script src="/socket.io/socket.io.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Poppins', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: {
                        game: { dark: '#050505', card: 'rgba(24, 24, 27, 0.6)', primary: '#6366f1', accent: '#06b6d4' }
                    }
                }
            }
        }
    </script>

    <style>
        body { 
            font-family: 'Poppins', sans-serif; 
            background-color: #050505; 
            color: white; 
            overflow-x: hidden; 
        }
        .ambient-light { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; overflow: hidden; }
        .blob { position: absolute; filter: blur(80px); opacity: 0.4; animation: float 10s infinite ease-in-out; }
        .blob-1 { top: -10%; left: -10%; width: 500px; height: 500px; background: #6366f1; animation-delay: 0s; }
        .blob-2 { bottom: -10%; right: -10%; width: 400px; height: 400px; background: #ec4899; animation-delay: 2s; }
        .blob-3 { top: 40%; left: 40%; width: 300px; height: 300px; background: #06b6d4; opacity: 0.2; animation-delay: 4s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 33% { transform: translate(30px, -50px) scale(1.1); } 66% { transform: translate(-20px, 20px) scale(0.9); } }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0a0a0b; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
    </style>
</head>
<body class="font-sans flex flex-col min-h-screen selection:bg-cyan-500 selection:text-black">

    <div class="ambient-light" aria-hidden="true">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <!-- Main Navbar (Role-Adaptive Responsive Header) -->
    <% 
        const currentActive = typeof active !== 'undefined' ? active : '';
        const currentUser = typeof user !== 'undefined' ? user : null;
        const currentRole = currentUser ? currentUser.role : 'guest';
    %>
    <nav class="fixed w-full z-50 top-0 transition-all duration-300 backdrop-blur-xl bg-[#09090b]/85 border-b border-white/[0.08]" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Left: Logo & Brand with Role Badge -->
                <div class="flex items-center flex-1 justify-start">
                    <a href="<%= currentRole === 'admin' ? '/admin' : (currentRole === 'staff' ? '/staff' : '/') %>" class="flex items-center group nav-home-link select-none py-1">
                        <div class="relative flex items-center justify-center">
                            <div class="absolute inset-0 bg-gradient-to-tr <%= currentRole === 'admin' ? 'from-purple-500/30 via-indigo-500/20 to-pink-500/30' : (currentRole === 'staff' ? 'from-emerald-500/30 via-teal-500/20 to-cyan-500/30' : 'from-cyan-500/30 via-indigo-500/20 to-purple-500/30') %> rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-500 scale-125 pointer-events-none"></div>
                            <img src="/images/ZenithPrimeLogoTransparant.png" 
                                 alt="ZenithPrime Logo" 
                                 class="w-10 h-10 object-contain relative z-10 transition-all duration-300 ease-out transform group-hover:scale-110 group-hover:-translate-y-0.5 filter drop-shadow-[0_2px_8px_rgba(99,102,241,0.35)] group-hover:drop-shadow-[0_0_16px_rgba(6,182,212,0.7)] will-change-transform">
                        </div>
                        <div class="ml-3 flex items-center gap-2">
                            <span class="text-2xl font-extrabold tracking-tight text-white transition-all duration-300">
                                Zenith<span class="<%= currentRole === 'admin' ? 'text-indigo-400 group-hover:text-purple-400' : (currentRole === 'staff' ? 'text-emerald-400 group-hover:text-teal-400' : 'text-cyan-400 group-hover:text-indigo-400') %> transition-colors duration-300">Prime</span>
                            </span>
                            <% if (currentRole === 'admin') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_12px_rgba(99,102,241,0.3)]">
                                    Admin Suite
                                </span>
                            <% } else if (currentRole === 'staff') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 shadow-[0_0_12px_rgba(16,185,129,0.3)]">
                                    Staff Portal
                                </span>
                            <% } %>
                        </div>
                    </a>
                </div>

                <!-- Center: Navigation Pill Capsule (Adapted per Role) -->
                <div class="hidden md:flex items-center justify-center flex-shrink-0">
                    <div class="flex items-center space-x-1 bg-white/[0.04] border border-white/[0.08] p-1.5 rounded-full backdrop-blur-md shadow-inner shadow-black/30">
                        <% if (currentRole === 'admin') { %>
                            <!-- ADMIN CENTER NAVIGATION -->
                            <a href="/admin" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'admin_dashboard' || currentActive === 'admin' ? 'text-white bg-gradient-to-r from-indigo-500/30 to-purple-500/30 border border-indigo-500/40 shadow-[0_0_12px_rgba(99,102,241,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>📊</span>
                                <span>Dashboard</span>
                            </a>
                            <a href="/admin/transactions" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'admin_transactions' ? 'text-white bg-gradient-to-r from-indigo-500/30 to-purple-500/30 border border-indigo-500/40 shadow-[0_0_12px_rgba(99,102,241,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>💳</span>
                                <span>Transaksi</span>
                            </a>
                            <a href="/admin/games" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'admin_games' ? 'text-white bg-gradient-to-r from-indigo-500/30 to-purple-500/30 border border-indigo-500/40 shadow-[0_0_12px_rgba(99,102,241,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>🎮</span>
                                <span>Katalog</span>
                            </a>
                            <a href="/admin/joki" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'admin_joki' ? 'text-white bg-gradient-to-r from-indigo-500/30 to-purple-500/30 border border-indigo-500/40 shadow-[0_0_12px_rgba(99,102,241,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>⚔️</span>
                                <span>Kelola Joki</span>
                            </a>
                            <a href="/staff" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= ['staff', 'staff_joki', 'chat'].includes(currentActive) ? 'text-white bg-gradient-to-r from-emerald-500/30 to-teal-500/30 border border-emerald-500/40 shadow-[0_0_12px_rgba(16,185,129,0.3)]' : 'text-emerald-400/90 hover:text-emerald-300 hover:bg-emerald-500/10' %>">
                                <span>💼</span>
                                <span>Staff Portal</span>
                            </a>
                            <a href="/" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= ['home', 'games', 'joki', 'history', 'support'].includes(currentActive) ? 'text-white bg-gradient-to-r from-cyan-500/30 to-blue-500/30 border border-cyan-500/40' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
                                <span>🌐</span>
                                <span>Web Toko</span>
                            </a>

                        <% } else if (currentRole === 'staff') { %>
                            <!-- STAFF CENTER NAVIGATION (FOKUS MONITORING & PELAYANAN) -->
                            <a href="/staff" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'staff' || currentActive === 'staff_dashboard' ? 'text-white bg-gradient-to-r from-emerald-500/30 to-teal-500/30 border border-emerald-500/40 shadow-[0_0_12px_rgba(16,185,129,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>⚡</span>
                                <span>Antrian Top Up</span>
                            </a>
                            <a href="/staff/joki" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'staff_joki' ? 'text-white bg-gradient-to-r from-cyan-500/30 to-indigo-500/30 border border-cyan-500/40 shadow-[0_0_12px_rgba(6,182,212,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>⚔️</span>
                                <span>Workspace Joki</span>
                            </a>
                            <a href="/staff/chat" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'chat' || currentActive === 'staff_chat' ? 'text-white bg-gradient-to-r from-indigo-500/30 to-purple-500/30 border border-indigo-500/40 shadow-[0_0_12px_rgba(99,102,241,0.3)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                                <span>Live Chat CS</span>
                            </a>
                            <a href="/" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'home' ? 'text-white bg-gradient-to-r from-cyan-500/30 to-indigo-500/30 border border-cyan-500/40' : 'text-slate-400 hover:text-white hover:bg-white/5' %>">
                                <span>🏠</span>
                                <span>Lihat Toko</span>
                            </a>

                        <% } else { %>
                            <!-- REGULAR USER / CUSTOMER CENTER NAVIGATION -->
                            <a href="/" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'home' ? 'text-white bg-gradient-to-r from-cyan-500/25 to-indigo-500/25 border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.25)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>Beranda</span>
                            </a>
                            <a href="/games" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'games' ? 'text-white bg-gradient-to-r from-cyan-500/25 to-indigo-500/25 border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.25)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>Katalog Game</span>
                            </a>
                            <a href="/joki" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'joki' ? 'text-white bg-gradient-to-r from-cyan-500/25 to-indigo-500/25 border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.25)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>Jasa Joki</span>
                            </a>
                            <a href="/history" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'history' ? 'text-white bg-gradient-to-r from-cyan-500/25 to-indigo-500/25 border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.25)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>Riwayat</span>
                            </a>
                            <a href="/contact" class="px-4 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 <%= currentActive === 'support' ? 'text-white bg-gradient-to-r from-cyan-500/25 to-indigo-500/25 border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.25)]' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
                                <span>Bantuan</span>
                            </a>
                            <% if (currentRole === 'user') { %>
                            <button onclick="toggleChat()" type="button" class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-all duration-200 flex items-center gap-1.5 text-cyan-300 hover:text-white hover:bg-cyan-500/20 border border-transparent hover:border-cyan-500/30 cursor-pointer group">
                                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 group-hover:bg-cyan-300 animate-pulse"></span>
                                <span>Chat CS</span>
                            </button>
                            <% } %>
                        <% } %>
                    </div>
                </div>

                <!-- Right: Role Actions & User Profile -->
                <div class="hidden md:flex items-center flex-1 justify-end space-x-3">
                    <% if (currentUser) { %>
                        <% if (currentRole === 'admin') { %>
                            <!-- ADMIN RIGHT STATUS & PROFILE -->
                            <div class="flex items-center gap-2.5">
                                <span class="hidden xl:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-xs font-semibold">
                                    <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                                    <span>Superuser</span>
                                </span>

                                <div class="flex items-center bg-white/[0.04] border border-white/10 rounded-full pl-2 pr-1.5 py-1 backdrop-blur-md hover:border-white/20 transition-all">
                                    <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-xs font-black text-white shadow-sm ring-1 ring-white/20 mr-2 select-none">
                                        <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
                                    </div>
                                    <div class="mr-3 text-left hidden lg:block">
                                        <div class="text-xs font-bold text-white leading-tight max-w-[110px] truncate"><%= currentUser.name %></div>
                                        <div class="text-[9px] uppercase tracking-wider text-indigo-400 font-mono font-bold">Admin Suite</div>
                                    </div>
                                    <a href="/auth/logout" title="Keluar Akun" class="p-1.5 px-2.5 rounded-full bg-red-500/10 hover:bg-red-500/25 border border-red-500/20 text-red-400 hover:text-red-300 text-xs font-semibold flex items-center gap-1 transition-all">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                        <span class="hidden xl:inline text-[11px]">Logout</span>
                                    </a>
                                </div>
                            </div>

                        <% } else if (currentRole === 'staff') { %>
                            <!-- STAFF RIGHT STATUS & PROFILE -->
                            <div class="flex items-center gap-2.5">
                                <div class="hidden xl:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                    <span>On Duty</span>
                                </div>

                                <div class="flex items-center bg-white/[0.04] border border-white/10 rounded-full pl-2 pr-1.5 py-1 backdrop-blur-md hover:border-white/20 transition-all">
                                    <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-emerald-500 to-teal-600 flex items-center justify-center text-xs font-black text-white shadow-sm ring-1 ring-white/20 mr-2 select-none">
                                        <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'S' %>
                                    </div>
                                    <div class="mr-3 text-left hidden lg:block">
                                        <div class="text-xs font-bold text-white leading-tight max-w-[110px] truncate"><%= currentUser.name %></div>
                                        <div class="text-[9px] uppercase tracking-wider text-emerald-400 font-mono font-bold">Staff Operator</div>
                                    </div>
                                    <a href="/auth/logout" title="Keluar Akun" class="p-1.5 px-2.5 rounded-full bg-red-500/10 hover:bg-red-500/25 border border-red-500/20 text-red-400 hover:text-red-300 text-xs font-semibold flex items-center gap-1 transition-all">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                        <span class="hidden xl:inline text-[11px]">Logout</span>
                                    </a>
                                </div>
                            </div>

                        <% } else { %>
                            <!-- REGULAR USER PROFILE -->
                            <div class="flex items-center bg-white/[0.04] border border-white/10 rounded-full pl-2 pr-1.5 py-1 backdrop-blur-md hover:border-white/20 transition-all">
                                <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center text-xs font-black text-white shadow-sm ring-1 ring-white/20 mr-2 select-none">
                                    <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
                                </div>
                                <div class="mr-3 text-left hidden lg:block">
                                    <div class="text-xs font-bold text-white leading-tight max-w-[110px] truncate"><%= currentUser.name %></div>
                                    <div class="text-[9px] uppercase tracking-wider text-cyan-400/90 font-mono font-semibold"><%= currentUser.role || 'Member' %></div>
                                </div>
                                <a href="/auth/logout" title="Keluar" class="p-1.5 px-2.5 rounded-full bg-red-500/10 hover:bg-red-500/25 border border-red-500/20 text-red-400 hover:text-red-300 text-xs font-semibold flex items-center gap-1 transition-all">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                    <span class="hidden xl:inline text-[11px]">Logout</span>
                                </a>
                            </div>
                        <% } %>
                    <% } else { %>
                        <!-- GUEST USER -->
                        <div class="flex items-center gap-2">
                            <a href="/auth/login" class="text-slate-300 hover:text-white font-medium text-xs sm:text-sm px-4 py-2 rounded-full hover:bg-white/5 transition-all">
                                Masuk
                            </a>
                            <a href="/auth/register" class="flex items-center gap-1.5 px-5 py-2 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white text-xs sm:text-sm font-bold shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/40 transition-all transform hover:-translate-y-0.5">
                                <span>Daftar Sekarang</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Mobile Hamburger Button -->
                <div class="md:hidden flex items-center gap-2">
                    <button onclick="toggleMobileMenu()" class="p-2 rounded-xl bg-white/5 border border-white/10 text-white hover:bg-white/10 transition-colors" aria-label="Toggle Menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Drawer (Role-Adaptive Mobile Dropdown) -->
        <div id="mobile-menu" class="hidden md:hidden bg-[#09090b]/98 backdrop-blur-2xl border-b border-white/10 shadow-2xl transition-all duration-300">
            <div class="px-5 pt-3 pb-6 space-y-3 max-w-lg mx-auto">
                <% if (currentUser) { %>
                    <!-- User Profile Card in Mobile -->
                    <div class="flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.04] border border-white/10 mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full <%= currentRole === 'admin' ? 'bg-gradient-to-tr from-indigo-500 to-purple-600' : (currentRole === 'staff' ? 'bg-gradient-to-tr from-emerald-500 to-teal-600' : 'bg-gradient-to-tr from-cyan-500 to-indigo-600') %> flex items-center justify-center font-bold text-white shadow-md text-sm ring-1 ring-white/20">
                                <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div>
                                <div class="text-sm font-bold text-white"><%= currentUser.name %></div>
                                <div class="text-[10px] uppercase tracking-wider <%= currentRole === 'admin' ? 'text-indigo-400' : (currentRole === 'staff' ? 'text-emerald-400' : 'text-cyan-400') %> font-mono font-semibold">
                                    <%= currentRole === 'admin' ? 'Superuser Admin' : (currentRole === 'staff' ? 'Staff Operator' : 'Member') %>
                                </div>
                            </div>
                        </div>
                        <a href="/auth/logout" class="px-3 py-1.5 rounded-full bg-red-500/10 hover:bg-red-500/25 border border-red-500/20 text-red-400 text-xs font-semibold flex items-center gap-1 transition-all">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                            <span>Logout</span>
                        </a>
                    </div>
                <% } %>

                <!-- Mobile Navigation Links per Role -->
