        <script>
            const socket = io();
            const userId = '<%= user.id %>';
            const roomId = 'user_' + userId;
            
            const chatToggleBtn = document.getElementById('chatToggleBtn');
            const chatBox = document.getElementById('chatBox');
            const chatForm = document.getElementById('chatForm');
            const chatInput = document.getElementById('chatInput');
            const messagesList = document.getElementById('messagesList');
            const badge = document.getElementById('userChatBadge');
            const notifSound = document.getElementById('notifSound');
            const iconBubble = document.getElementById('icon-bubble');
            const iconClose = document.getElementById('icon-close');
            
            let unreadCount = 0;
            let historyLoaded = false;

            function formatMarkdown(text) {
                if (!text) return '';
                // 1. Escape HTML untuk mencegah XSS
                let escaped = text
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
                
                // 2. Format Bold: **teks**
                escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-white">$1</strong>');
                
                // 3. Format Inline Code: `code`
                escaped = escaped.replace(/`([^`]+)`/g, '<code class="bg-black/60 text-cyan-300 px-1.5 py-0.5 rounded text-[11px] font-mono border border-cyan-500/20">$1</code>');
                
                // 4. Format Markdown Link: [teks](url)
                escaped = escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-cyan-400 underline hover:text-cyan-300 font-semibold">$1</a>');
                
                // 5. Line break
                escaped = escaped.replace(/\n/g, '<br>');
                return escaped;
            }

            function sendQuickReply(replyText) {
                if (chatInput && chatForm) {
                    chatInput.value = replyText;
                    chatForm.dispatchEvent(new Event('submit', { cancelable: true }));
                }
            }

            function appendMessageBubble(message, isStaff, isAi, quickReplies) {
                const div = document.createElement('div');
                div.className = isStaff ? "flex flex-col items-start gap-1.5 max-w-[92%]" : "flex justify-end";

                if (isStaff) {
                    const headerDiv = document.createElement('div');
                    headerDiv.className = "flex items-center gap-1.5 text-[10px] text-slate-400 pl-1";
                    if (isAi) {
                        headerDiv.innerHTML = `<span class="flex items-center gap-1 text-cyan-300 font-bold"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>🤖 Zenith AI Assistant</span>`;
                    } else {
                        headerDiv.innerHTML = `<span class="flex items-center gap-1 text-emerald-300 font-bold"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>👨‍💼 CS Staff Zenith</span>`;
                    }
                    div.appendChild(headerDiv);

                    const bubble = document.createElement('div');
                    bubble.className = isAi 
                        ? "bg-[#181824] border border-cyan-500/25 text-slate-100 px-4 py-2.5 rounded-2xl rounded-tl-none text-xs leading-relaxed shadow-lg shadow-cyan-950/20 w-full"
                        : "bg-white/10 border border-white/5 text-slate-100 px-4 py-2.5 rounded-2xl rounded-tl-none text-xs leading-relaxed max-w-[85%]";
                    bubble.innerHTML = formatMarkdown(message);
                    div.appendChild(bubble);

                    if (Array.isArray(quickReplies) && quickReplies.length > 0) {
                        const chipsContainer = document.createElement('div');
                        chipsContainer.className = "flex flex-wrap gap-1.5 pt-1 pl-1";
                        quickReplies.forEach(qr => {
                            const chip = document.createElement('button');
                            chip.type = "button";
                            chip.className = "px-2.5 py-1 rounded-full bg-cyan-500/10 hover:bg-cyan-500/25 border border-cyan-500/30 text-cyan-300 hover:text-white text-[10px] font-semibold transition active:scale-95";
                            chip.textContent = qr;
                            chip.onclick = () => sendQuickReply(qr);
                            chipsContainer.appendChild(chip);
                        });
                        div.appendChild(chipsContainer);
                    }
                } else {
                    const bubble = document.createElement('div');
                    bubble.className = "bg-gradient-to-r from-cyan-600 to-indigo-600 text-white px-4 py-2.5 rounded-2xl rounded-tr-none text-xs leading-relaxed max-w-[82%] shadow-md shadow-cyan-900/20";
                    bubble.textContent = message; // Raw text (anti-XSS)
                    div.appendChild(bubble);
                }
                
                messagesList.appendChild(div);
            }

            async function loadChatHistory() {
                if (historyLoaded) return;
                try {
                    const res = await fetch('/api/chat-history');
                    const data = await res.json();
                    if (data.success && Array.isArray(data.chats)) {
                        data.chats.forEach(item => {
                            appendMessageBubble(item.message, item.is_staff_reply === 1, item.is_ai === 1, null);
                        });
                        historyLoaded = true;
                        messagesList.scrollTop = messagesList.scrollHeight;
                    }
                } catch (e) {
                    console.log("Could not load history:", e);
                }
            }

            function toggleChat() {
                if (!chatBox) return;
                if (chatBox.style.display === 'none' || !chatBox.style.display) {
                    chatBox.style.display = 'block';
                    setTimeout(() => { 
                        chatBox.classList.remove('scale-95', 'opacity-0'); 
                    }, 10);
                    
                    unreadCount = 0;
                    if (badge) {
                        badge.innerText = '0';
                        badge.style.display = 'none';
                    }
                    if (chatToggleBtn) chatToggleBtn.classList.remove('notify-active');
                    
                    if (iconBubble) iconBubble.classList.add('hidden');
                    if (iconClose) iconClose.classList.remove('hidden');

                    loadChatHistory();
                    setTimeout(() => {
                        messagesList.scrollTop = messagesList.scrollHeight;
                        if (chatInput) chatInput.focus();
                    }, 100);
                } else {
                    chatBox.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => { chatBox.style.display = 'none'; }, 250);
                    if (iconBubble) iconBubble.classList.remove('hidden');
                    if (iconClose) iconClose.classList.add('hidden');
                }
            }

            socket.emit('join_chat', userId);

            if (chatForm) {
                chatForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const msg = chatInput.value.trim();
                    if (msg) {
                        const data = { sender_id: userId, room_id: roomId, message: msg, is_staff: false };
                        socket.emit('send_message', data);
                        chatInput.value = '';
                    }
                });
            }

            socket.on('receive_message', (data) => {
                appendMessageBubble(data.message, data.is_staff, data.is_ai, data.quick_replies);
                messagesList.scrollTop = messagesList.scrollHeight;

                if (data.is_staff) {
                    if (chatBox.style.display === 'none') {
                        if (notifSound) {
                            notifSound.currentTime = 0;
                            notifSound.play().catch(e => console.log('Autoplay blocked'));
                        }
                        unreadCount++;
                        if (badge) {
                            badge.innerText = unreadCount > 99 ? '99+' : unreadCount;
                            badge.style.display = 'flex';
                        }
                        if (chatToggleBtn) chatToggleBtn.classList.add('notify-active');
                    }
                }
            });
        </script>
    <% } %>

    <style type="text/tailwindcss">
        .badge-role { @apply text-xs font-bold tracking-wider border px-3 py-1.5 rounded-lg transition-all; }
        .btn-logout { @apply px-5 py-2 rounded-full bg-white/5 border border-white/10 hover:bg-red-500/20 hover:border-red-500/50 hover:text-red-400 transition-all text-sm font-semibold backdrop-blur-sm; }
        .btn-primary { @apply px-6 py-2.5 rounded-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white text-sm font-bold shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 transition-all transform hover:-translate-y-0.5; }
        .mobile-link { @apply block px-3 py-3 rounded-lg hover:bg-white/10 text-white font-medium; }
        .mobile-role-link { @apply block px-3 py-3 rounded-lg font-bold mb-2 border; }
        .social-icon { @apply w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white transition-all; }
        .footer-heading { @apply text-white font-bold text-lg mb-6 relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-1/2 after:h-1 after:rounded-full; }
        .footer-heading.decoration-cyan-500::after { @apply bg-cyan-500; }
        .footer-heading.decoration-pink-500::after { @apply bg-pink-500; }
        .footer-heading.decoration-purple-500::after { @apply bg-purple-500; }
        .footer-link { @apply text-slate-400 hover:text-cyan-400 transition-colors flex items-center gap-2; }
        .bullet { @apply w-1.5 h-1.5 rounded-full; }
        .payment-badge { @apply bg-white px-2 py-1 rounded shadow h-8 flex items-center justify-center; }
    </style>

    <script>
        function toggleMobileMenu() { 
            const menu = document.getElementById('mobile-menu');
            if (menu) menu.classList.toggle('hidden'); 
        }

        // Close mobile menu on outside click
        document.addEventListener('click', (e) => {
            const menu = document.getElementById('mobile-menu');
            const hamburger = e.target.closest('button[onclick*="toggleMobileMenu"]');
            if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target) && !hamburger) {
                menu.classList.add('hidden');
            }
        });

        document.addEventListener('DOMContentLoaded', () => {
            const navbar = document.getElementById('navbar');
            if (navbar) {
                const handleScroll = () => {
                    if (window.scrollY > 20) {
                        navbar.classList.add('bg-[#09090b]/95', 'shadow-2xl', 'shadow-black/70', 'border-white/[0.12]');
                        navbar.classList.remove('bg-[#09090b]/80');
                    } else {
                        navbar.classList.remove('bg-[#09090b]/95', 'shadow-2xl', 'shadow-black/70', 'border-white/[0.12]');
                        navbar.classList.add('bg-[#09090b]/80');
                    }
                };
                window.addEventListener('scroll', handleScroll, { passive: true });
                handleScroll();
            }

            document.querySelectorAll('.nav-home-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    if (window.location.pathname === '/') { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
                });
            });
        });
    </script>
</body>
</html>