<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin Panel' %> - ZenithPrime</title>
    <link rel="icon" type="image/png" href="/images/ZenithPrimeLogoTransparant.png">
    <link rel="apple-touch-icon" href="/images/ZenithPrimeLogoTransparant.png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Poppins', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: {
                        admin: { dark: '#09090b', card: '#121217', border: 'rgba(255, 255, 255, 0.08)' }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #060608; color: white; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #09090b; }
        ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
    </style>
</head>
<body class="font-sans flex h-screen overflow-hidden bg-[#060608] selection:bg-indigo-500 selection:text-white">

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebarBackdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/80 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <!-- Sidebar -->
    <aside id="adminSidebar" class="fixed md:static inset-y-0 left-0 w-64 bg-[#0c0c10] border-r border-white/[0.08] flex flex-col z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl">
        
        <!-- Logo & Brand Header -->
        <div class="h-20 flex items-center justify-between px-6 border-b border-white/[0.08] bg-[#09090c]">
            <a href="/admin" class="flex items-center gap-3 group select-none">
                <div class="relative flex items-center justify-center">
                    <div class="absolute inset-0 bg-indigo-500/20 rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-500 scale-125 pointer-events-none"></div>
                    <img src="/images/ZenithPrimeLogoTransparant.png" 
                         alt="ZenithPrime Logo" 
                         class="w-8 h-8 object-contain relative z-10 transition-transform duration-300 group-hover:scale-110">
                </div>
                <div class="flex flex-col">
                    <span class="text-lg font-black text-white tracking-tight leading-none">
                        Zenith<span class="text-indigo-400">Admin</span>
                    </span>
                    <span class="text-[9px] uppercase tracking-wider font-mono text-slate-500 mt-1">Superuser Suite</span>
                </div>
            </a>
            <button onclick="toggleSidebar()" class="md:hidden text-slate-400 hover:text-white p-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <!-- Navigation Menu -->
        <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto">
            <div class="px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                Menu Utama
            </div>

            <a href="/admin" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'dashboard' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <span class="text-base">📊</span>
                <span>Dashboard Overview</span>
            </a>

            <a href="/admin/transactions" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'transactions' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <div class="flex items-center gap-3">
                    <span class="text-base">💸</span>
                    <span>Transaksi Top Up</span>
                </div>
            </a>

            <a href="/admin/joki" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'joki' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <div class="flex items-center gap-3">
                    <span class="text-base">🛡️</span>
                    <span>Kelola Jasa Joki</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-300 font-mono font-bold">New</span>
            </a>

            <a href="/admin/games" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'games' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <span class="text-base">🎮</span>
                <span>Katalog Game & Item</span>
            </a>

            <div class="pt-4 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                Pemasaran & Konten
            </div>

            <a href="/admin/promos" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'promos' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <span class="text-base">🎟️</span>
                <span>Voucher & Diskon</span>
            </a>

            <a href="/admin/updates" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'updates' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <span class="text-base">📢</span>
                <span>Update & Pengumuman</span>
            </a>

            <div class="pt-4 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                Sistem & Keamanan
            </div>

            <a href="/admin/security" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all group <%= typeof path !== 'undefined' && path === 'security' ? 'bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 shadow-[0_0_15px_rgba(99,102,241,0.2)]' : 'text-slate-400 hover:text-white hover:bg-white/[0.04]' %>">
                <div class="flex items-center gap-3">
                    <span class="text-base">🛡️</span>
                    <span>Security Center</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono font-bold">Google L3</span>
            </a>

            <div class="pt-4 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                Akses Peran Lain
            </div>

            <a href="/staff" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-emerald-400 hover:bg-emerald-500/10 border border-emerald-500/20 transition-all">
                <div class="flex items-center gap-3">
                    <span class="text-base">💼</span>
                    <span>Workspace Staff</span>
                </div>
                <span class="text-xs">→</span>
            </a>

            <a href="/staff/chat" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-cyan-400 hover:bg-cyan-500/10 border border-cyan-500/20 transition-all">
                <div class="flex items-center gap-3">
                    <span class="text-base">💬</span>
                    <span>Live Chat CS</span>
                </div>
                <span class="text-xs">→</span>
            </a>
        </nav>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-white/[0.08] bg-[#09090c] space-y-2">
            <a href="/" target="_blank" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl bg-white/[0.04] hover:bg-white/10 text-slate-300 hover:text-white text-xs font-semibold transition border border-white/5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                <span>Lihat Web Publik</span>
            </a>
            
            <a href="/auth/logout" class="flex items-center justify-center gap-2 w-full py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-semibold transition border border-red-500/20">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                <span>Keluar Akun</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-w-0 overflow-hidden bg-[#060608]">
        
        <!-- Top App Bar -->
        <header class="h-20 border-b border-white/[0.08] flex items-center justify-between px-4 sm:px-8 bg-[#09090c]/80 backdrop-blur-xl sticky top-0 z-20">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="md:hidden text-slate-300 hover:text-white p-2 rounded-xl bg-white/5 border border-white/10">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <div>
                    <h1 class="text-lg sm:text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
                        <%= typeof title !== 'undefined' ? title : 'Admin Panel' %>
                    </h1>
                    <p class="text-[11px] text-slate-500 font-mono hidden sm:block">ZenithPrime Core Management Control</p>
                </div>
            </div>

            <!-- Header Right Widgets -->
            <div class="flex items-center gap-2.5 sm:gap-3.5">
                <!-- Quick Role Links -->
                <a href="/" target="_blank" class="hidden lg:flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10 transition" title="Lihat Tampilan Web Toko">
                    <span>🌐</span>
                    <span>Toko Publik</span>
                </a>

                <a href="/staff" class="hidden sm:flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/20 transition" title="Buka Workspace Staff">
                    <span>💼</span>
                    <span>Staff Desk</span>
                </a>

                <!-- System Status Indicator -->
                <div class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Server Online</span>
                </div>

                <!-- Admin Profile Pill -->
                <div class="flex items-center gap-2.5 bg-white/[0.04] border border-white/10 rounded-full pl-2 pr-3 py-1.5">
                    <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-xs font-bold text-white shadow-sm ring-1 ring-white/20">
                        <%= typeof user !== 'undefined' && user.name ? user.name.charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <div class="text-left">
                        <div class="text-xs font-bold text-white leading-tight max-w-[100px] truncate"><%= typeof user !== 'undefined' ? user.name : 'Administrator' %></div>
                        <div class="text-[9px] uppercase tracking-wider text-indigo-400 font-mono font-bold">Admin Suite</div>
                    </div>
                </div>

                <!-- Quick Logout Button -->
                <a href="/auth/logout" title="Keluar Akun" class="p-2 rounded-full bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 hover:text-red-300 transition flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                </a>
            </div>
        </header>

        <!-- Body Scrollable Content -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-8">
            <%- body %>
        </div>
    </main>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
            }
        }
    </script>
</body>
</html>