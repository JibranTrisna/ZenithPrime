<div class="space-y-6">

    <!-- Top Heading -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-black text-white tracking-tight">Pusat Berita & Pengumuman</h2>
            <p class="text-slate-400 text-xs sm:text-sm mt-1">Publikasikan informasi event, jadwal maintenance, atau promo spesial ke pengguna situs.</p>
        </div>
        <div>
            <span class="text-xs text-slate-500 font-mono bg-white/[0.04] border border-white/10 px-3 py-1.5 rounded-full">
                Total Artikel: <b class="text-white"><%= news.length %></b>
            </span>
        </div>
    </div>

    <!-- Create News Composer Card -->
    <div class="bg-[#121217] p-6 rounded-2xl border border-white/10 relative overflow-hidden shadow-xl">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-white/10">
            <span class="text-base">✍️</span>
            <h3 class="text-base font-bold text-white">Tulis Pengumuman Baru</h3>
        </div>

        <form action="/admin/updates/add" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="md:col-span-3">
                    <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Judul Pengumuman <span class="text-red-400">*</span></label>
                    <input type="text" name="title" placeholder="Contoh: Maintenance Server Rutin Tanggal 25 Oktober 2026" required 
                           class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white text-xs focus:border-indigo-500 outline-none transition">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Kategori Tipe</label>
                    <select name="type" class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white text-xs focus:border-indigo-500 outline-none transition font-semibold">
                        <option value="INFO">ℹ️ INFO</option>
                        <option value="MAINTENANCE">🛠️ MAINTENANCE</option>
                        <option value="EVENT">🎉 EVENT</option>
                        <option value="PROMO">🎟️ PROMO</option>
                        <option value="UPDATE">⚡ UPDATE</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Isi Pesan / Konten <span class="text-red-400">*</span></label>
                <textarea name="content" rows="4" placeholder="Tuliskan isi detail berita pengumuman secara jelas untuk pelanggan..." required 
                          class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white text-xs focus:border-indigo-500 outline-none transition leading-relaxed"></textarea>
            </div>
            
            <div class="flex justify-end pt-2">
                <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-2">
                    <span>📢</span>
                    <span>Publikasikan Sekarang</span>
                </button>
            </div>
        </form>
    </div>

    <!-- News List Feed -->
    <div>
        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Daftar Pengumuman Terbit</h3>
        
        <div class="space-y-3">
            <% if (news.length === 0) { %>
                <div class="text-center py-12 rounded-2xl bg-[#121217] border border-white/10 text-slate-500 text-xs">
                    Belum ada pengumuman yang dipublikasikan.
                </div>
            <% } else { %>
                <% news.forEach(item => { %>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-[#121217] p-5 rounded-2xl border border-white/10 hover:border-white/20 transition group">
                    <div class="space-y-1.5 flex-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <% 
                                let badgeClass = "bg-white/10 text-white border-white/10";
                                if (item.type === 'MAINTENANCE') badgeClass = "bg-yellow-500/10 text-yellow-400 border-yellow-500/20";
                                else if (item.type === 'EVENT') badgeClass = "bg-purple-500/10 text-purple-400 border-purple-500/20";
                                else if (item.type === 'PROMO') badgeClass = "bg-emerald-500/10 text-emerald-400 border-emerald-500/20";
                                else if (item.type === 'UPDATE') badgeClass = "bg-cyan-500/10 text-cyan-400 border-cyan-500/20";
                            %>
                            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border <%= badgeClass %>">
                                <%= item.type %>
                            </span>
                            <span class="text-[11px] text-slate-500 font-mono">
                                <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                            </span>
                        </div>
                        
                        <h4 class="font-bold text-white text-sm group-hover:text-cyan-400 transition"><%= item.title %></h4>
                        <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed"><%= item.content %></p>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        <form action="/admin/updates/delete" method="POST" onsubmit="return confirm('Hapus artikel pengumuman ini?');">
                            <input type="hidden" name="id" value="<%= item.id %>">
                            <button class="px-3 py-1.5 rounded-xl bg-red-500/10 hover:bg-red-600 text-red-400 hover:text-white transition border border-red-500/20 text-xs font-semibold flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                <span>Hapus</span>
                            </button>
                        </form>
                    </div>
                </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>