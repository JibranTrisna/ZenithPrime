<div class="space-y-6">

    <!-- Top Heading & Add Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-black text-white tracking-tight">Kelola Voucher & Kode Promo</h2>
            <p class="text-slate-400 text-xs sm:text-sm mt-1">Buat kode voucher diskon untuk memikat pelanggan dan meningkatkan omset transaksi.</p>
        </div>
        <div>
            <button onclick="openAddPromoModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-xs shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-2">
                <span>+</span>
                <span>Buat Voucher Baru</span>
            </button>
        </div>
    </div>

    <!-- Voucher Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% promos.forEach(promo => { %>
        <div class="bg-[#121217] rounded-2xl border border-white/10 hover:border-indigo-500/50 transition-all duration-300 shadow-xl relative overflow-hidden flex flex-col justify-between group">
            
            <!-- Perforation Decor Circles -->
            <div class="absolute -left-3 top-24 w-6 h-6 rounded-full bg-[#060608] border-r border-white/10 z-10"></div>
            <div class="absolute -right-3 top-24 w-6 h-6 rounded-full bg-[#060608] border-l border-white/10 z-10"></div>

            <div class="p-6 pb-4">
                <!-- Header with Status -->
                <div class="flex items-center justify-between gap-2 mb-3">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase
                        <%= promo.status === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20' %>">
                        <%= promo.status %>
                    </span>
                    <span class="text-[10px] text-slate-500 font-mono">Diskon <%= promo.discount_percent %>%</span>
                </div>

                <!-- Promo Code Box with Copy Button -->
                <div class="p-3 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between mb-4">
                    <div class="font-mono text-xl font-black text-white tracking-widest uppercase">
                        <%= promo.code %>
                    </div>
                    <button onclick="copyCode('<%= promo.code %>')" title="Salin Kode" class="p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-cyan-400 hover:text-white transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    </button>
                </div>

                <!-- Dashed Perforation Line -->
                <div class="border-b border-dashed border-white/10 my-4"></div>

                <!-- Details List -->
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between items-center text-slate-400">
                        <span>Potongan Diskon:</span>
                        <span class="text-indigo-400 font-bold font-mono"><%= promo.discount_percent %>%</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-400">
                        <span>Maksimal Diskon:</span>
                        <span class="text-white font-mono font-bold">Rp <%= Number(promo.max_discount).toLocaleString('id-ID') %></span>
                    </div>
                    <div class="flex justify-between items-center text-slate-400">
                        <span>Sisa Kuota:</span>
                        <span class="text-cyan-400 font-mono font-bold"><%= promo.quota %> Transaksi</span>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="p-4 bg-black/20 border-t border-white/5 flex items-center gap-2">
                <form action="/admin/promos/status" method="POST" class="flex-1">
                    <input type="hidden" name="id" value="<%= promo.id %>">
                    <input type="hidden" name="status" value="<%= promo.status === 'active' ? 'inactive' : 'active' %>">
                    <button class="w-full py-2 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5
                        <%= promo.status === 'active' ? 'bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white border border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500 hover:text-white border border-emerald-500/20' %>">
                        <%= promo.status === 'active' ? '⏸️ Nonaktifkan' : '▶️ Aktifkan' %>
                    </button>
                </form>

                <form action="/admin/promos/delete" method="POST" onsubmit="return confirm('Hapus voucher <%= promo.code %> selamanya?');">
                    <input type="hidden" name="id" value="<%= promo.id %>">
                    <button class="p-2 px-3 rounded-xl bg-white/5 hover:bg-red-600 text-slate-400 hover:text-white transition border border-white/10" title="Hapus Voucher">
                        🗑️
                    </button>
                </form>
            </div>
        </div>
        <% }) %>
    </div>

    <% if (promos.length === 0) { %>
        <div class="text-center py-20 border-2 border-dashed border-white/10 rounded-3xl bg-[#121217]">
            <p class="text-slate-500 mb-4">Belum ada voucher promo yang dibuat.</p>
            <button onclick="openAddPromoModal()" class="text-indigo-400 font-bold hover:text-indigo-300 text-sm">Buat Voucher Pertama</button>
        </div>
    <% } %>
</div>

<!-- Add Promo Modal -->
<div id="addPromoModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-[#121217] w-full max-w-md rounded-2xl border border-white/10 p-6 shadow-2xl relative overflow-hidden">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/10">
            <div>
                <h3 class="text-lg font-black text-white">Buat Voucher Promo Baru</h3>
                <p class="text-slate-400 text-xs">Atur kode diskon dan batas maksimal potongan.</p>
            </div>
            <button onclick="closeAddPromoModal()" class="text-slate-400 hover:text-white p-1">✕</button>
        </div>
        
        <form action="/admin/promos/add" method="POST" class="space-y-4">
            <div>
                <label class="text-[11px] font-bold text-slate-400 uppercase block mb-1">Kode Voucher <span class="text-red-400">*</span></label>
                <input type="text" name="code" placeholder="Contoh: MERDEKA45" required 
                       class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white font-mono text-sm uppercase focus:border-indigo-500 outline-none transition tracking-wider">
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-[11px] font-bold text-slate-400 uppercase block mb-1">Diskon (%) <span class="text-red-400">*</span></label>
                    <input type="number" name="discount_percent" placeholder="10" min="1" max="100" step="0.5" required 
                           class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white text-xs focus:border-indigo-500 outline-none transition font-mono">
                </div>
                <div>
                    <label class="text-[11px] font-bold text-slate-400 uppercase block mb-1">Kuota Pemakaian <span class="text-red-400">*</span></label>
                    <input type="number" name="quota" placeholder="100" min="1" required 
                           class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white text-xs focus:border-indigo-500 outline-none transition font-mono">
                </div>
            </div>

            <div>
                <label class="text-[11px] font-bold text-slate-400 uppercase block mb-1">Maksimal Potongan (Rp) <span class="text-red-400">*</span></label>
                <input type="number" name="max_discount" placeholder="25000" min="1000" step="500" required 
                       class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white text-xs focus:border-indigo-500 outline-none transition font-mono">
                <p class="text-[10px] text-slate-500 mt-1">Batas plafon diskon rupiah tertinggi yang didapat user.</p>
            </div>

            <div class="flex gap-3 pt-4 border-t border-white/10 mt-6">
                <button type="button" onclick="closeAddPromoModal()" class="flex-1 bg-white/5 hover:bg-white/10 text-white py-2.5 rounded-xl font-bold text-xs transition">Batal</button>
                <button type="submit" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white py-2.5 rounded-xl font-bold text-xs transition shadow-lg shadow-indigo-600/20">Simpan Voucher</button>
            </div>
        </form>
    </div>
</div>

<!-- Copy Code Toast -->
<div id="promoToast" class="fixed bottom-6 right-6 z-50 bg-[#18181b] border border-cyan-500/30 text-cyan-300 px-4 py-2.5 rounded-xl shadow-2xl text-xs font-semibold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <span>📋</span>
    <span id="promoToastText">Kode voucher disalin!</span>
</div>

<script>
    function openAddPromoModal() {
        document.getElementById('addPromoModal').classList.remove('hidden');
    }
    function closeAddPromoModal() {
        document.getElementById('addPromoModal').classList.add('hidden');
    }

    function copyCode(code) {
        navigator.clipboard.writeText(code).then(() => {
            const toast = document.getElementById('promoToast');
            const textEl = document.getElementById('promoToastText');
            textEl.innerText = `Kode "${code}" berhasil disalin!`;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        });
    }
</script>