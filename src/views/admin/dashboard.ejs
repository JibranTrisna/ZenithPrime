<!-- Copy Feedback Toast Notification -->
<div id="copyToast" class="fixed bottom-6 right-6 z-50 bg-[#18181b] border border-cyan-500/40 text-cyan-400 px-4 py-2.5 rounded-2xl shadow-2xl flex items-center gap-2.5 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 text-xs font-semibold">
    <span>📋</span>
    <span id="copyToastText">Berhasil disalin ke clipboard!</span>
</div>

<script>
    let hourlyChartInstance = null;
    let dailyChartInstance = null;

    const formatRupiah = (number) => {
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(number || 0);
    };

    function copyToClipboard(text, label) {
        navigator.clipboard.writeText(text).then(() => {
            const toast = document.getElementById('copyToast');
            const toastText = document.getElementById('copyToastText');
            toastText.textContent = `${label || 'ID'} "${text}" disalin!`;
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 2500);
        });
    }

    async function fetchDashboardData() {
        try {
            document.getElementById('last-updated').innerText = 'Updating...';
            
            const response = await fetch('/admin/api/stats');
            const data = await response.json();

            document.getElementById('stat-revenue').innerText = formatRupiah(data.stats.revenue);
            document.getElementById('stat-profit').innerText = formatRupiah(data.stats.profit);
            document.getElementById('stat-loss').innerText = formatRupiah(data.stats.loss);
            document.getElementById('stat-users').innerText = (data.stats.users || 0).toLocaleString('id-ID');
            document.getElementById('stat-games').innerText = (data.stats.games || 0).toLocaleString('id-ID');
            document.getElementById('stat-pending').innerText = (data.stats.pending || 0).toLocaleString('id-ID');

            const tbody = document.getElementById('recent-orders-body');
            tbody.innerHTML = '';

            if (!data.recentOrders || data.recentOrders.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-slate-500">
                            <div class="text-3xl mb-2">📭</div>
                            <div class="font-bold text-white text-sm">Belum Ada Transaksi</div>
                            <div class="text-xs text-slate-500 mt-0.5">Semua transaksi terbaru akan otomatis tampil di sini.</div>
                        </td>
                    </tr>
                `;
            } else {
                data.recentOrders.forEach(t => {
                    const statusConfig = {
                        success: { class: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20', icon: '✓', label: 'Sukses' },
                        pending: { class: 'bg-amber-500/10 text-amber-400 border border-amber-500/20', icon: '⏳', label: 'Pending' },
                        failed: { class: 'bg-red-500/10 text-red-400 border border-red-500/20', icon: '✕', label: 'Gagal' },
                        settlement: { class: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20', icon: '✓', label: 'Sukses' }
                    };
                    const badge = statusConfig[t.status] || { class: 'bg-slate-500/10 text-slate-400 border border-white/10', icon: '•', label: t.status };
                    
                    const row = `
                        <tr class="hover:bg-white/[0.03] transition group">
                            <td class="px-6 py-4 font-mono font-bold text-white">
                                <div class="flex items-center gap-2">
                                    <span>#${t.id}</span>
                                    <button onclick="copyToClipboard('${t.id}', 'Order ID')" class="text-slate-500 hover:text-cyan-400 text-[11px] transition" title="Salin Order ID">
                                        📋
                                    </button>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-bold text-white flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-full bg-white/10 text-slate-300 text-[10px] flex items-center justify-center font-bold">
                                        ${(t.user_name || 'U').charAt(0).toUpperCase()}
                                    </span>
                                    <span>${t.user_name || 'Guest User'}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-slate-200">${t.product_name || 'Item Digital'}</div>
                            </td>
                            <td class="px-6 py-4 font-mono font-bold text-cyan-400">
                                ${formatRupiah(t.amount)}
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold ${badge.class}">
                                    <span>${badge.icon}</span>
                                    <span class="uppercase">${badge.label}</span>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/admin/transactions" class="text-xs text-indigo-400 hover:text-indigo-300 font-bold hover:underline">
                                    Detail &rarr;
                                </a>
                            </td>
                        </tr>
                    `;
                    tbody.innerHTML += row;
                });
            }

            updateCharts(data.charts);

            const now = new Date();
            document.getElementById('last-updated').innerText = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' WIB';

        } catch (error) {
            console.error("Gagal update dashboard:", error);
            document.getElementById('last-updated').innerText = 'Offline / Error';
        }
    }

    function updateCharts(chartsData) {
        if (!chartsData) return;
        const ctx1 = document.getElementById('hourlyChart').getContext('2d');
        const ctx2 = document.getElementById('dailyChart').getContext('2d');

        if (hourlyChartInstance) hourlyChartInstance.destroy();
        
        const gradientHourly = ctx1.createLinearGradient(0, 0, 0, 300);
        gradientHourly.addColorStop(0, 'rgba(6, 182, 212, 0.4)');
        gradientHourly.addColorStop(1, 'rgba(6, 182, 212, 0)');

        hourlyChartInstance = new Chart(ctx1, {
            type: 'line',
            data: {
                labels: chartsData.hourly.labels,
                datasets: [{
                    label: 'Omset (Rp)',
                    data: chartsData.hourly.data,
                    borderColor: '#22d3ee',
                    backgroundColor: gradientHourly,
                    borderWidth: 3,
                    pointBackgroundColor: '#060608',
                    pointBorderColor: '#22d3ee',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#18181b',
                        titleColor: '#fff',
                        bodyColor: '#22d3ee',
                        borderColor: 'rgba(255,255,255,0.1)',
                        borderWidth: 1,
                        padding: 10,
                        displayColors: false,
                        callbacks: {
                            label: function(context) {
                                return 'Omset: ' + formatRupiah(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: { 
                            color: '#94a3b8',
                            font: { size: 10 },
                            callback: function(value) {
                                if (value >= 1000000) return 'Rp ' + (value/1000000).toFixed(1) + 'M';
                                if (value >= 1000) return 'Rp ' + (value/1000).toFixed(0) + 'k';
                                return value;
                            }
                        }
                    },
                    x: { 
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 10 }, maxTicksLimit: 8 }
                    }
                }
            }
        });

        if (dailyChartInstance) dailyChartInstance.destroy();

        dailyChartInstance = new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: chartsData.daily.labels,
                datasets: [{
                    label: 'Omset Harian',
                    data: chartsData.daily.data,
                    backgroundColor: '#a855f7',
                    borderRadius: 6,
                    hoverBackgroundColor: '#c084fc'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#18181b',
                        titleColor: '#fff',
                        bodyColor: '#c084fc',
                        borderColor: 'rgba(255,255,255,0.1)',
                        borderWidth: 1,
                        padding: 10,
                        displayColors: false,
                        callbacks: {
                            label: function(context) {
                                return 'Omset: ' + formatRupiah(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: { 
                            color: '#94a3b8',
                            font: { size: 10 },
                            callback: function(value) {
                                if (value >= 1000000) return 'Rp ' + (value/1000000).toFixed(1) + 'M';
                                if (value >= 1000) return 'Rp ' + (value/1000).toFixed(0) + 'k';
                                return value;
                            }
                        }
                    },
                    x: { 
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 10 } }
                    }
                }
            }
        });
    }

    fetchDashboardData();
    setInterval(fetchDashboardData, 30000); // 30s auto-refresh
</script>