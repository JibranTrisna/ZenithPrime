<div class="space-y-6">

    <!-- Top Heading & Refresh -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-black text-white tracking-tight">Manajemen Transaksi Top Up</h2>
            <p class="text-slate-400 text-xs sm:text-sm mt-1">Pantau seluruh riwayat transaksi top up, setujui pesanan pending, dan kelola status pembayaran.</p>
        </div>
        <div class="flex items-center gap-2.5">
            <button onclick="window.location.reload()" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/[0.04] hover:bg-white/10 border border-white/10 text-xs font-semibold text-slate-300 transition">
                <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                <span>Refresh Data</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Metric Cards -->
    <% 
        let totalRev = 0;
        let countPending = 0;
        let countSuccess = 0;
        let countFailed = 0;
        orders.forEach(o => {
            if (o.status === 'success') {
                totalRev += Number(o.amount || 0);
                countSuccess++;
            } else if (o.status === 'pending') {
                countPending++;
            } else {
                countFailed++;
            }
        });
    %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-[#121217] border border-white/10 relative overflow-hidden">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Transaksi</span>
            <div class="text-2xl font-black text-white mt-1 font-mono"><%= orders.length %></div>
            <span class="text-[10px] text-slate-500 mt-0.5 block">Semua pesanan masuk</span>
        </div>

        <div class="p-5 rounded-2xl bg-[#121217] border border-yellow-500/20 relative overflow-hidden">
            <span class="text-[11px] font-bold uppercase tracking-wider text-yellow-400">Perlu Diproses</span>
            <div class="text-2xl font-black text-yellow-300 mt-1 font-mono"><%= countPending %></div>
            <span class="text-[10px] text-yellow-500/80 mt-0.5 block">Pesanan status pending</span>
        </div>

        <div class="p-5 rounded-2xl bg-[#121217] border border-emerald-500/20 relative overflow-hidden">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Transaksi Sukses</span>
            <div class="text-2xl font-black text-emerald-300 mt-1 font-mono"><%= countSuccess %></div>
            <span class="text-[10px] text-emerald-500/80 mt-0.5 block"><%= countFailed %> gagal / expired</span>
        </div>

        <div class="p-5 rounded-2xl bg-[#121217] border border-cyan-500/20 relative overflow-hidden">
            <span class="text-[11px] font-bold uppercase tracking-wider text-cyan-400">Total Omset Sukses</span>
            <div class="text-xl sm:text-2xl font-black text-cyan-300 mt-1 font-mono truncate">
                Rp <%= totalRev.toLocaleString('id-ID') %>
            </div>
            <span class="text-[10px] text-cyan-500/80 mt-0.5 block">Gross revenue bersih</span>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#121217] p-4 rounded-2xl border border-white/10">
        <!-- Status Filter Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
            <button onclick="filterStatus('all')" id="tabFilterAll" class="filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-indigo-600 text-white shadow-md">
                Semua (<%= orders.length %>)
            </button>
            <button onclick="filterStatus('pending')" id="tabFilterPending" class="filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white hover:bg-white/5">
                Pending (<%= countPending %>)
            </button>
            <button onclick="filterStatus('success')" id="tabFilterSuccess" class="filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white hover:bg-white/5">
                Sukses (<%= countSuccess %>)
            </button>
            <button onclick="filterStatus('failed')" id="tabFilterFailed" class="filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white hover:bg-white/5">
                Gagal / Expired (<%= countFailed %>)
            </button>
        </div>

        <!-- Search Box -->
        <div class="relative w-full md:w-72">
            <input type="text" id="trxSearchInput" onkeyup="searchTransactions()" placeholder="Cari ID, user, game, target..." 
                   class="w-full pl-9 pr-4 py-2.5 rounded-xl bg-black/40 border border-white/10 text-xs text-white placeholder-slate-500 focus:border-indigo-500 outline-none transition">
            <svg class="w-4 h-4 text-slate-500 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
    </div>

    <!-- Transactions Data Table -->
    <div class="bg-[#121217] rounded-2xl border border-white/10 overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300" id="trxTable">
                <thead class="bg-white/[0.03] text-white uppercase font-bold text-[11px] border-b border-white/[0.08]">
                    <tr>
                        <th class="px-6 py-4">ID Transaksi</th>
                        <th class="px-6 py-4">Pelanggan</th>
                        <th class="px-6 py-4">Game & Produk</th>
                        <th class="px-6 py-4">Target Akun</th>
                        <th class="px-6 py-4">Total Biaya</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-center">Aksi Kelola</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.05]" id="trxTableBody">
                    <% if (orders.length === 0) { %>
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-slate-500">
                                Belum ada transaksi yang tercatat dalam database.
                            </td>
                        </tr>
                    <% } else { %>
                        <% orders.forEach(order => { %>
                        <tr class="hover:bg-white/[0.03] transition trx-row" data-status="<%= order.status %>" data-search="<%= order.id %> <%= order.order_id || '' %> <%= (order.user_name || '').toLowerCase() %> <%= (order.game_name || '').toLowerCase() %> <%= (order.product_name || '').toLowerCase() %> <%= order.target_id || '' %> <%= order.zone_id || '' %>">
                            <!-- ID & Tanggal -->
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-1.5 font-mono text-white font-bold">
                                    <span>#<%= order.id %></span>
                                    <button onclick="copyToClipboard('<%= order.id %>')" title="Copy ID" class="text-slate-500 hover:text-cyan-400 transition">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    </button>
                                </div>
                                <div class="text-[10px] text-slate-500 mt-0.5">
                                    <%= new Date(order.created_at).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                </div>
                                <% if (order.order_id) { %>
                                    <div class="text-[9px] text-slate-600 font-mono mt-0.5 select-all"><%= order.order_id %></div>
                                <% } %>
                            </td>

                            <!-- User -->
                            <td class="px-6 py-4">
                                <div class="text-white font-bold"><%= order.user_name %></div>
                                <div class="text-[10px] text-slate-500">ID User: <%= order.user_id %></div>
                            </td>

                            <!-- Item & Game -->
                            <td class="px-6 py-4">
                                <div class="text-white font-semibold"><%= order.product_name %></div>
                                <div class="text-[11px] text-indigo-400 font-medium"><%= order.game_name %></div>
                            </td>

                            <!-- Target ID -->
                            <td class="px-6 py-4 font-mono">
                                <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-black/40 border border-white/5 text-white text-[11px]">
                                    <span>ID: <%= order.target_id %></span>
                                    <% if (order.zone_id) { %>
                                        <span class="text-slate-400">(<%= order.zone_id %>)</span>
                                    <% } %>
                                </div>
                            </td>

                            <!-- Harga -->
                            <td class="px-6 py-4">
                                <span class="font-mono font-bold text-emerald-400 text-sm">
                                    Rp <%= Number(order.amount).toLocaleString('id-ID') %>
                                </span>
                            </td>

                            <!-- Status Badge -->
                            <td class="px-6 py-4 text-center">
                                <% if (order.status === 'success') { %>
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[11px] font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                        Sukses
                                    </span>
                                <% } else if (order.status === 'pending') { %>
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 text-[11px] font-bold animate-pulse">
                                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
                                        Pending
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-red-500/10 text-red-400 border border-red-500/20 text-[11px] font-bold">
                                        <%= order.status %>
                                    </span>
                                <% } %>
                            </td>

                            <!-- Action -->
                            <td class="px-6 py-4 text-center">
                                <% if (order.status === 'pending') { %>
                                    <div class="flex items-center justify-center gap-2">
                                        <form action="/admin/transactions/update" method="POST">
                                            <input type="hidden" name="id" value="<%= order.id %>">
                                            <input type="hidden" name="status" value="success">
                                            <button class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition shadow-md shadow-emerald-600/20 flex items-center gap-1">
                                                <span>✓</span> Terima
                                            </button>
                                        </form>
                                        <form action="/admin/transactions/update" method="POST" onsubmit="return confirm('Tolak pesanan #<%= order.id %>?');">
                                            <input type="hidden" name="id" value="<%= order.id %>">
                                            <input type="hidden" name="status" value="failed">
                                            <button class="px-2.5 py-1.5 rounded-lg bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/30 text-xs font-semibold transition" title="Tolak">
                                                ✕
                                            </button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-600 text-xs font-mono">Tuntas</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Copy Toast Notification -->
<div id="copyToast" class="fixed bottom-6 right-6 z-50 bg-[#18181b] border border-cyan-500/30 text-cyan-300 px-4 py-2.5 rounded-xl shadow-2xl text-xs font-semibold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <span>📋</span>
    <span id="copyToastText">ID berhasil disalin!</span>
</div>

<script>
    let currentFilter = 'all';

    function filterStatus(status) {
        currentFilter = status;
        
        // Update tab styles
        const tabs = [
            { id: 'tabFilterAll', key: 'all' },
            { id: 'tabFilterPending', key: 'pending' },
            { id: 'tabFilterSuccess', key: 'success' },
            { id: 'tabFilterFailed', key: 'failed' }
        ];

        tabs.forEach(t => {
            const btn = document.getElementById(t.id);
            if (t.key === status) {
                btn.className = "filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition bg-indigo-600 text-white shadow-md";
            } else {
                btn.className = "filter-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white hover:bg-white/5";
            }
        });

        applyFilters();
    }

    function searchTransactions() {
        applyFilters();
    }

    function applyFilters() {
        const query = (document.getElementById('trxSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.trx-row');

        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status');
            const rowSearch = (row.getAttribute('data-search') || '').toLowerCase();

            let matchStatus = false;
            if (currentFilter === 'all') matchStatus = true;
            else if (currentFilter === 'pending' && rowStatus === 'pending') matchStatus = true;
            else if (currentFilter === 'success' && rowStatus === 'success') matchStatus = true;
            else if (currentFilter === 'failed' && (rowStatus === 'failed' || rowStatus === 'expired')) matchStatus = true;

            const matchQuery = !query || rowSearch.includes(query);

            if (matchStatus && matchQuery) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            const toast = document.getElementById('copyToast');
            const textEl = document.getElementById('copyToastText');
            textEl.innerText = `ID #${text} berhasil disalin!`;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        });
    }
</script>