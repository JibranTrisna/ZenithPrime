<!-- Staff Portal Unified Navigation Capsule Header -->
<div class="mb-8 space-y-4">
    <!-- Top Bar with Operator Status & Quick Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#121217] border border-white/10 p-5 rounded-3xl shadow-xl backdrop-blur-xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-center gap-4 relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 to-cyan-600 flex items-center justify-center font-black text-white text-lg shadow-lg shadow-emerald-500/20">
                <%= typeof user !== 'undefined' && user.name ? user.name.charAt(0).toUpperCase() : 'S' %>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight">Staff Operations Center</h1>
                    <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-[10px] font-mono font-bold uppercase tracking-wider">
                        Active Shift
                    </span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">
                    Operator: <b class="text-white"><%= typeof user !== 'undefined' ? user.name : 'Staff Member' %></b> • <%= typeof user !== 'undefined' ? user.email : '' %>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 relative z-10">
            <% if (typeof user !== 'undefined' && user.role === 'admin') { %>
                <a href="/admin" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 text-purple-300 text-xs font-bold transition">
                    <span>⚡ Admin Panel</span>
                </a>
            <% } %>
            <button onclick="window.location.reload()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-cyan-300 hover:text-white text-xs font-semibold transition" title="Refresh Halaman">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                <span>Refresh</span>
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 border-b border-white/10">
        <a href="/staff" class="px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 shrink-0 <%= typeof active !== 'undefined' && active === 'staff' ? 'bg-gradient-to-r from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/20' : 'bg-[#18181b] border border-white/10 text-slate-400 hover:text-white hover:border-white/20' %>">
            <span>💎</span>
            <span>Antrian Top Up</span>
            <% if (typeof pendingOrders !== 'undefined' && pendingOrders.length > 0) { %>
                <span class="px-2 py-0.5 rounded-full bg-yellow-400/20 text-yellow-300 text-[10px] font-mono"><%= pendingOrders.length %></span>
            <% } %>
        </a>

        <a href="/staff/joki" class="px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 shrink-0 <%= typeof active !== 'undefined' && active === 'staff_joki' ? 'bg-gradient-to-r from-cyan-500 to-indigo-600 text-white shadow-lg shadow-cyan-500/20' : 'bg-[#18181b] border border-white/10 text-slate-400 hover:text-white hover:border-white/20' %>">
            <span>🛡️</span>
            <span>Workspace Joki Game</span>
            <% if (typeof queuedOrders !== 'undefined' && queuedOrders.length > 0) { %>
                <span class="px-2 py-0.5 rounded-full bg-yellow-400/20 text-yellow-300 text-[10px] font-mono"><%= queuedOrders.length %></span>
            <% } %>
        </a>

        <a href="/staff/chat" class="px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold transition-all flex items-center gap-2 shrink-0 <%= typeof active !== 'undefined' && active === 'chat' ? 'bg-gradient-to-r from-indigo-500 to-purple-600 text-white shadow-lg shadow-indigo-500/20' : 'bg-[#18181b] border border-white/10 text-slate-400 hover:text-white hover:border-white/20' %>">
            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
            <span>Live CS Chat Desk</span>
        </a>
    </div>
</div>
