<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start py-8">
    <div class="lg:col-span-4 lg:sticky lg:top-24">
        <div class="bg-[#18181b] border border-white/10 rounded-3xl overflow-hidden p-6 shadow-2xl mb-6">
            <div class="aspect-video rounded-2xl overflow-hidden mb-6 shadow-lg relative bg-black/50 group">
                <img src="/images/games/<%= game.thumbnail %>" 
                     onerror="this.src='https://placehold.co/600x337/1e293b/FFF?text=<%= game.name %>'"
                     class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
                
                <div class="absolute inset-0 bg-gradient-to-t from-[#18181b]/50 via-transparent to-transparent"></div>
            </div>
            
            <h2 class="text-2xl font-bold text-white text-center mb-2"><%= game.name %></h2>
            <div class="flex justify-center mb-6">
                <span class="px-3 py-1 bg-green-500/10 text-green-400 text-xs font-bold rounded-full border border-green-500/20 animate-pulse">
                    ● System Online
                </span>
            </div>
            <div class="border-t border-white/10 pt-4">
                <p class="text-slate-400 text-sm text-center leading-relaxed">
                    Top up resmi <b><%= game.name %></b>. Proses otomatis instan 24 jam.
                </p>
            </div>
        </div>

        <div class="bg-[#18181b] border border-white/10 rounded-3xl p-6 shadow-lg">
            <div class="flex items-center gap-3 mb-4 border-b border-white/10 pb-3">
                <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <h3 class="text-lg font-bold text-white">Cara Top Up</h3>
            </div>
            
            <ol class="list-decimal list-outside pl-4 space-y-2 text-sm text-slate-300 leading-relaxed marker:text-cyan-500">
                <% 
                    if (game.instructions) {
                        const steps = game.instructions.split('\n');
                        steps.forEach(step => {
                            let cleanStep = step.replace(/^\d+\.\s*/, '');
                            if(cleanStep.trim() !== '') {
                %>
                    <li><%= cleanStep %></li>
                <% 
                            }
                        });
                    } else { 
                %>
                    <li>Masukkan ID Akun.</li>
                    <li>Pilih Nominal.</li>
                    <li>Selesaikan Pembayaran.</li>
                <% } %>
            </ol>
        </div>
    </div>

    <div class="lg:col-span-8">
        <form action="/transaction/process" method="POST">
            
            <div class="bg-[#18181b] border border-white/10 rounded-3xl p-6 mb-6 shadow-lg">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-10 h-10 flex items-center justify-center bg-cyan-600 rounded-xl font-bold text-white shadow-lg shadow-cyan-500/30 text-lg">1</div>
                    <h3 class="text-xl font-bold text-white">Data Akun</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% if (['genshin-impact', 'honkai-star-rail', 'wuthering-waves', 'tower-of-fantasy'].includes(game.slug)) { %>
                        <div class="md:col-span-1">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">UID</label>
                            <input type="text" name="target_id" placeholder="Masukkan UID" required class="input-field">
                        </div>
                        <div class="md:col-span-1">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">SERVER</label>
                            <select name="zone_id" class="input-field cursor-pointer">
                                <option value="Asia">Asia</option>
                                <option value="America">America</option>
                                <option value="Europe">Europe</option>
                                <option value="TW/HK/MO">TW/HK/MO</option>
                            </select>
                        </div>
                    <% } else if (game.slug === 'growtopia') { %>
                        <div class="md:col-span-1">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">GROW ID</label>
                            <input type="text" name="target_id" placeholder="Nama Akun" required class="input-field">
                        </div>
                        <div class="md:col-span-1">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">WORLD NAME</label>
                            <input type="text" name="zone_id" placeholder="Nama World (Harus ada Donation Box)" required class="input-field">
                        </div>
                    <% } else if (game.requires_zone) { %>
                        <div class="md:col-span-1">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">USER ID</label>
                            <input type="text" name="target_id" placeholder="Contoh: 12345678" required class="input-field">
                        </div>
                        <div class="md:col-span-1">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">ZONE ID</label>
                            <input type="text" name="zone_id" placeholder="Contoh: 2024" required class="input-field">
                        </div>
                    <% } else { %>
                        <div class="md:col-span-2">
                            <label class="text-xs text-slate-400 font-bold ml-2 mb-1 block">
                                <%= ['valorant', 'league-of-legends'].includes(game.slug) ? 'RIOT ID (Name#Tag)' : 
                                    ['clash-of-clans', 'clash-royale'].includes(game.slug) ? 'PLAYER TAG' : 'USER ID / UID' %>
                            </label>
                            <input type="text" name="target_id" placeholder="Masukkan ID Akun" required class="input-field">
                        </div>
                    <% } %>
                </div>
                <p class="text-xs text-slate-500 mt-4 flex items-center gap-1 italic">
                    *Pastikan data yang dimasukkan sudah benar sesuai instruksi di samping.
                </p>
            </div>

            <div class="bg-[#18181b] border border-white/10 rounded-3xl p-6 mb-8 shadow-lg">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-10 h-10 flex items-center justify-center bg-cyan-600 rounded-xl font-bold text-white shadow-lg shadow-cyan-500/30 text-lg">2</div>
                    <h3 class="text-xl font-bold text-white">Pilih Nominal</h3>
                </div>
                
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    <% products.forEach(product => { %>
                        <label class="cursor-pointer relative group">
                            <input type="radio" 
                                   name="product_id" 
                                   value="<%= product.id %>" 
                                   data-price="<%= product.price %>" 
                                   class="peer sr-only" 
                                   required>
                            
                            <div class="h-full min-h-[150px] bg-[#27272a] border border-white/5 rounded-2xl p-4 flex flex-col items-center justify-between text-center transition-all duration-300
                                        hover:bg-[#3f3f46] hover:border-white/20 hover:-translate-y-1
                                        peer-checked:bg-[#27272a] peer-checked:border-pink-500 peer-checked:shadow-[0_0_20px_rgba(236,72,153,0.2)]">
                                
                                <span class="text-white font-bold text-sm leading-snug group-hover:text-white/90">
                                    <%= product.name %>
                                </span>

                                <div class="w-10 h-10 my-2 flex items-center justify-center relative">
                                    <div class="absolute inset-0 bg-pink-500/20 blur-xl rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                    <svg class="w-8 h-8 text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]" fill="url(#grad1)" viewBox="0 0 24 24">
                                        <defs>
                                            <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                                <stop offset="0%" style="stop-color:#22d3ee;stop-opacity:1" />
                                                <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
                                            </linearGradient>
                                        </defs>
                                        <path d="M12,2L2,12L12,22L22,12L12,2Z" stroke="none"/>
                                        <path d="M12,4L4.5,12L12,20L19.5,12L12,4M12,2L2,12L12,22L22,12L12,2Z" fill="currentColor" opacity="0.8"/>
                                    </svg>
                                </div>
                                
                                <div class="w-full pt-2 border-t border-white/5">
                                    <p class="text-[10px] text-slate-400 mb-0.5">Harga</p>
                                    <span class="block text-pink-500 text-sm font-bold font-mono tracking-wide">
                                        Rp <%= Number(product.price).toLocaleString('id-ID') %>
                                    </span>
                                </div>

                                <div class="absolute top-0 right-0 p-2 opacity-0 peer-checked:opacity-100 transition-all duration-300">
                                    <div class="bg-pink-500 text-white rounded-bl-xl rounded-tr-xl p-1 shadow-lg">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"></path></svg>
                                    </div>
                                </div>
                            </div>
                        </label>
                    <% }) %>
                </div>
            </div>

            <div class="bg-[#18181b] p-6 rounded-2xl border border-white/10 mb-6 shadow-xl relative overflow-hidden">
                <div class="absolute top-0 right-0 w-20 h-20 bg-indigo-500/10 rounded-full blur-xl"></div>
                
                <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                    <span class="bg-indigo-600 w-6 h-6 rounded-full flex items-center justify-center text-xs">3</span>
                    Makin Hemat Pakai Promo
                </h3>

                <div class="flex gap-2">
                    <input type="text" id="promoCodeInput" name="promo_code" 
                        class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-indigo-500 outline-none font-mono uppercase placeholder:normal-case"
                        placeholder="Punya kode voucher? Masukkan disini">
                    <button type="button" id="btnCheckPromo" 
                            class="bg-indigo-600 hover:bg-indigo-500 text-white px-6 rounded-xl font-bold transition whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed">
                        Gunakan
                    </button>
                </div>

                <div id="promoMessage" class="mt-3 text-sm hidden"></div>
            </div>

            <div class="bg-[#18181b] p-6 rounded-2xl border border-white/10 mb-8 shadow-xl flex justify-between items-center">
                <span class="text-slate-400">Total Pembayaran</span>
                <div class="text-right">
                    <div id="basePriceDisplay" class="text-sm text-slate-500 line-through hidden">Rp 0</div>
                    <div id="totalPriceDisplay" class="text-2xl font-bold text-cyan-400">Rp 0</div>
                </div>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold py-4 rounded-2xl shadow-lg shadow-cyan-500/20 transition transform hover:scale-[1.01] text-lg tracking-wide">
                Beli Sekarang
            </button>
            
        </form>
    </div>
</div>

<style>
    .input-field {
        width: 100%;
        background-color: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem; 
        padding: 1rem;
        color: white;
        font-family: 'Poppins', sans-serif;
        transition: all 0.2s;
    }
    .input-field:focus {
        outline: none;
        border-color: #06b6d4; 
        box-shadow: 0 0 0 1px #06b6d4;
    }
</style>

<script>
    const totalPriceDisplay = document.getElementById('totalPriceDisplay');
    const basePriceDisplay = document.getElementById('basePriceDisplay');
    const promoInput = document.getElementById('promoCodeInput');
    const btnCheckPromo = document.getElementById('btnCheckPromo');
    const promoMessage = document.getElementById('promoMessage');

    const formatRupiah = (number) => {
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(number);
    }

    const productRadios = document.querySelectorAll('input[name="product_id"]');
    productRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            const price = parseInt(this.getAttribute('data-price'));
            
            updatePriceDisplay(price);
            resetPromo(price);
        });
    });

    function updatePriceDisplay(price) {
        totalPriceDisplay.innerText = formatRupiah(price);
        basePriceDisplay.classList.add('hidden'); 
    }

    function resetPromo(currentPrice) {
        promoMessage.classList.add('hidden');
        updatePriceDisplay(currentPrice); 
    }

    btnCheckPromo.addEventListener('click', async () => {
        const activeOption = document.querySelector('input[name="product_id"]:checked');
        const code = promoInput.value.trim();
        
        if (!activeOption) {
            showPromoMsg('Pilih item game dulu ya!', false);
            return;
        }

        if (!code) {
            showPromoMsg('Masukkan kode voucher dulu.', false);
            return;
        }

        const currentPrice = parseInt(activeOption.getAttribute('data-price'));

        try {
            const originalBtnText = btnCheckPromo.innerText;
            btnCheckPromo.innerText = 'Checking...';
            btnCheckPromo.disabled = true;

            const response = await fetch('/api/check-promo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, amount: currentPrice })
            });
            const result = await response.json();

            if (result.valid) {
                totalPriceDisplay.innerText = formatRupiah(result.newPrice);
                basePriceDisplay.innerText = formatRupiah(currentPrice);
                basePriceDisplay.classList.remove('hidden');

                showPromoMsg(result.message, true);
            } else {
                showPromoMsg(result.message, false);
                updatePriceDisplay(currentPrice);
            }
        } catch (err) {
            console.error(err);
            showPromoMsg('Gagal mengecek promo. Coba lagi.', false);
        } finally {
            btnCheckPromo.innerText = 'Gunakan';
            btnCheckPromo.disabled = false;
        }
    });

    function showPromoMsg(msg, isSuccess) {
        promoMessage.innerText = msg;
        promoMessage.classList.remove('hidden', 'text-green-400', 'text-red-400');
        promoMessage.classList.add(isSuccess ? 'text-green-400' : 'text-red-400');
    }
</script>