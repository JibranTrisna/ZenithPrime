<!-- Hero Header Container -->
<div class="relative rounded-3xl overflow-hidden mb-10 border border-white/10 bg-gradient-to-b from-[#18181b]/90 via-[#121217]/90 to-[#09090b]/90 backdrop-blur-2xl p-6 sm:p-10 md:p-12 shadow-2xl shadow-black/80">
    <!-- Ambient Background Neon Blooms -->
    <div class="absolute -top-24 -left-24 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="relative z-10 max-w-3xl mx-auto text-center">
        <!-- Breadcrumb & Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-500/10 backdrop-blur-md text-cyan-300 text-xs font-semibold mb-6 tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            <a href="/" class="hover:underline text-slate-300">Beranda</a>
            <span class="text-slate-500">/</span>
            <span>Katalog Game Resmi</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4 drop-shadow-md">
            Pilih & Top Up <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-indigo-400">
                Game Favorit Anda
            </span>
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8 max-w-xl mx-auto">
            Layanan pengisian diamond, voucher, dan item game berlisensi resmi publisher. Proses otomatis instan 24 jam dengan jaminan harga terbaik.
        </p>

        <!-- Search Bar with Glowing Focus -->
        <div class="relative max-w-xl mx-auto group">
            <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-indigo-600 rounded-2xl blur opacity-25 group-hover:opacity-50 group-focus-within:opacity-80 transition duration-500"></div>
            <div class="relative flex items-center bg-[#09090b]/90 border border-white/10 rounded-2xl p-1.5 transition-all group-focus-within:border-cyan-500/60 shadow-xl">
                <span class="pl-4 text-slate-400 group-focus-within:text-cyan-400 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text" id="searchCatalog" 
                    class="block w-full px-4 py-3 bg-transparent text-white placeholder-slate-500 focus:outline-none text-sm sm:text-base font-medium" 
                    placeholder="Ketik nama game (Mobile Legends, Valorant, Free Fire...)"
                    autocomplete="off">
                <button type="button" id="clearSearchBtn" class="hidden pr-3 text-slate-400 hover:text-white transition" title="Hapus pencarian">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Controls & Category Filter Dock -->
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/5 backdrop-blur-md">
    <!-- Category Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 md:pb-0 no-scrollbar">
        <button onclick="setCategory('all', this)" 
                class="category-btn active px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all duration-200 border border-cyan-500 bg-cyan-500/20 text-cyan-300 shadow-[0_0_15px_rgba(6,182,212,0.25)] whitespace-nowrap">
            Semua Game (<%= games.length %>)
        </button>

        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <button onclick="setCategory('<%= cat %>', this)" 
                        class="category-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 border border-white/10 bg-white/[0.03] text-slate-400 hover:text-white hover:bg-white/10 whitespace-nowrap">
                    <%= cat %>
                </button>
            <% }) %>
        <% } %>
    </div>

    <!-- Live Counter & Sort Indicator -->
    <div class="flex items-center justify-between md:justify-end gap-3 text-xs text-slate-400 font-medium">
        <span id="gameCountBadge" class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-300">
            Menampilkan <strong id="visibleCount" class="text-cyan-400 font-bold"><%= games.length %></strong> game
        </span>
        <button onclick="resetFilters()" class="text-slate-400 hover:text-cyan-400 transition underline underline-offset-4 text-xs">
            Reset
        </button>
    </div>
</div>

<!-- Game Cards Grid Container -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 sm:gap-6" id="gameGrid">
    <% if (games.length === 0) { %>
        <div class="col-span-full text-center py-20 rounded-2xl bg-white/[0.02] border border-dashed border-white/10">
            <p class="text-slate-400 text-base">Belum ada data game tersedia dalam database.</p>
        </div>
    <% } else { %>
        <% games.forEach(game => { %>
            <a href="/topup/<%= game.slug %>" 
               class="game-card group relative block h-full"
               data-title="<%= game.name.toLowerCase() %>"
               data-category="<%= game.category || '' %>">
                
                <!-- Ambient Hover Glow Halo -->
                <div class="absolute -inset-0.5 bg-gradient-to-br from-cyan-500 via-indigo-600 to-purple-600 rounded-2xl blur opacity-0 group-hover:opacity-70 transition duration-500"></div>
                
                <!-- Inner Card Body -->
                <div class="relative h-full bg-[#121217] rounded-2xl overflow-hidden border border-white/10 group-hover:border-transparent transition-all duration-300 flex flex-col shadow-xl group-hover:shadow-cyan-950/30 transform group-hover:-translate-y-1">
                    
                    <!-- Thumbnail Media Box (16:9 Aspect Ratio) -->
                    <div class="aspect-video overflow-hidden relative bg-black/60">
                        <img src="/images/games/<%= game.thumbnail %>" 
                             onerror="this.src='https://placehold.co/600x337/1e293b/FFF?text=<%= encodeURIComponent(game.name) %>'" 
                             alt="<%= game.name %>" 
                             class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
                        
                        <!-- Gradient Dark Overlay -->
                        <div class="absolute inset-0 bg-gradient-to-t from-[#121217] via-transparent to-black/30 pointer-events-none"></div>

                        <!-- Rating Badge -->
                        <div class="absolute top-3 left-3 px-2 py-1 bg-black/70 backdrop-blur-md rounded-lg border border-yellow-500/30 flex items-center gap-1 shadow-md z-10">
                            <svg class="w-3 h-3 text-yellow-400 fill-yellow-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            <span class="text-xs font-bold text-white"><%= Number(game.rating || 5.0).toFixed(1) %></span>
                        </div>

                        <!-- Category Pill Badge -->
                        <div class="absolute top-3 right-3 px-2 py-0.5 bg-black/70 backdrop-blur-md rounded text-[10px] text-cyan-300 border border-cyan-500/30 font-semibold tracking-wide uppercase z-10">
                            <%= game.category || 'GAME' %>
                        </div>
                    </div>

                    <!-- Card Info -->
                    <div class="p-4 sm:p-5 flex flex-col flex-grow justify-between">
                        <div>
                            <p class="text-slate-400 text-xs font-medium mb-1 truncate">
                                <%= game.developer || 'Official Publisher' %>
                            </p>
                            <h3 class="game-title text-white font-bold text-base sm:text-lg group-hover:text-cyan-400 transition-colors line-clamp-1">
                                <%= game.name %>
                            </h3>
                        </div>

                        <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-[11px] font-mono text-slate-300 font-semibold">INSTANT 24/7</span>
                            </div>

                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-cyan-500/10 text-cyan-300 group-hover:bg-cyan-500 group-hover:text-black transition-colors">
                                <span>Top Up</span>
                                <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </span>
                        </div>
                    </div>
                </div>
            </a>
        <% }); %>
    <% } %>
</div>

<!-- Empty Search Result State -->
<div id="noMatchContainer" class="hidden text-center py-20 rounded-3xl bg-white/[0.02] border border-white/10 mt-6 p-8">
    <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">Game Tidak Ditemukan</h3>
    <p class="text-slate-400 text-sm max-w-md mx-auto mb-6">
        Tidak ada game yang sesuai dengan kata kunci pencarian atau kategori yang Anda pilih.
    </p>
    <button onclick="resetFilters()" class="px-5 py-2.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-black font-bold text-xs sm:text-sm shadow-lg shadow-cyan-500/25 transition">
        Reset Filter & Tampilkan Semua
    </button>
</div>

<script>
    let currentCategory = 'all';
    const searchInput = document.getElementById('searchCatalog');
    const clearBtn = document.getElementById('clearSearchBtn');
    const gameCards = document.querySelectorAll('.game-card');
    const visibleCount = document.getElementById('visibleCount');
    const noMatchContainer = document.getElementById('noMatchContainer');

    function filterCatalog() {
        const query = searchInput.value.toLowerCase().trim();
        let matched = 0;

        if (clearBtn) {
            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }
        }

        gameCards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const category = card.getAttribute('data-category') || '';

            const matchesSearch = query === '' || title.includes(query);
            const matchesCat = currentCategory === 'all' || category.toLowerCase() === currentCategory.toLowerCase();

            if (matchesSearch && matchesCat) {
                card.style.display = 'block';
                matched++;
            } else {
                card.style.display = 'none';
            }
        });

        if (visibleCount) {
            visibleCount.textContent = matched;
        }

        if (noMatchContainer) {
            if (matched === 0 && gameCards.length > 0) {
                noMatchContainer.classList.remove('hidden');
            } else {
                noMatchContainer.classList.add('hidden');
            }
        }
    }

    function setCategory(category, element) {
        currentCategory = category;
        
        document.querySelectorAll('.category-btn').forEach(btn => {
            btn.classList.remove('active', 'border-cyan-500', 'bg-cyan-500/20', 'text-cyan-300', 'shadow-[0_0_15px_rgba(6,182,212,0.25)]');
            btn.classList.add('border-white/10', 'bg-white/[0.03]', 'text-slate-400');
        });

        if (element) {
            element.classList.remove('border-white/10', 'bg-white/[0.03]', 'text-slate-400');
            element.classList.add('active', 'border-cyan-500', 'bg-cyan-500/20', 'text-cyan-300', 'shadow-[0_0_15px_rgba(6,182,212,0.25)]');
        }

        filterCatalog();
    }

    function resetFilters() {
        if (searchInput) searchInput.value = '';
        const allBtn = document.querySelector('.category-btn');
        setCategory('all', allBtn);
    }

    if (searchInput) {
        searchInput.addEventListener('input', filterCatalog);
    }

    if (clearBtn) {
        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            filterCatalog();
            searchInput.focus();
        });
    }

    // Support deep link query params (?category=... or ?search=...)
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = urlParams.get('category');
        const searchParam = urlParams.get('search') || urlParams.get('q');

        if (searchParam && searchInput) {
            searchInput.value = searchParam;
        }

        if (catParam) {
            const targetBtn = Array.from(document.querySelectorAll('.category-btn')).find(btn => 
                btn.textContent.trim().toLowerCase().startsWith(catParam.toLowerCase())
            );
            if (targetBtn) {
                setCategory(catParam, targetBtn);
                return;
            }
        }

        filterCatalog();
    });
</script>