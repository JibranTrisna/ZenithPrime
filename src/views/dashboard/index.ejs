<style>
    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }
    .animate-marquee {
        animation: marquee 40s linear infinite;
    }
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<div class="relative w-full h-[450px] md:h-[500px] rounded-3xl overflow-hidden mb-6 border border-white/10 group shadow-2xl shadow-indigo-900/20 mt-6">
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/60 to-transparent z-10"></div>
        <video autoplay loop muted playsinline class="w-full h-full object-cover opacity-80">
            <source src="/images/ZenithPrimeBanner.mp4" type="video/mp4">
        </video>
        <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070" 
             class="absolute inset-0 w-full h-full object-cover -z-10" alt="Background">
    </div>
    
    <div class="relative z-20 h-full flex flex-col justify-center px-6 md:px-12 max-w-4xl">
        <div class="inline-flex items-center px-3 py-1 rounded-full border border-cyan-500/30 bg-black/40 backdrop-blur-md text-cyan-400 text-xs font-bold mb-6 tracking-wider uppercase w-fit animate-pulse">
            <span class="w-2 h-2 rounded-full bg-cyan-400 mr-2 shadow-[0_0_10px_#22d3ee]"></span> System Online
        </div>

        <h2 class="text-4xl md:text-6xl font-extrabold text-white mb-4 tracking-tight drop-shadow-xl">
            Selamat Datang, <br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500">
                <%= user ? user.name : 'Player One' %>
            </span>
        </h2>

        <p class="text-base md:text-lg text-slate-200 mb-8 max-w-xl leading-relaxed drop-shadow-md font-medium">
            Top up game favoritmu dalam hitungan detik. Gunakan kode: 
            <span class="font-mono font-bold text-yellow-300 bg-yellow-400/10 px-2 py-1 rounded border border-yellow-400/30 ml-1 cursor-pointer hover:bg-yellow-400/20 transition">ZenithPrimeUp</span>
        </p>

        <div class="relative max-w-md group">
            <div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-500 to-indigo-500 rounded-xl blur opacity-30 group-hover:opacity-70 transition duration-1000"></div>
            <div class="relative flex items-center bg-[#09090b]/90 rounded-xl border border-white/10 focus-within:border-cyan-500/50 transition-colors">
                <svg class="absolute left-4 w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input type="text" id="searchGame" 
                    class="block w-full pl-12 pr-4 py-4 bg-transparent text-white placeholder-slate-500 focus:outline-none font-mono text-sm" 
                    placeholder="Cari Game (contoh: MLBB)...">
            </div>
        </div>
    </div>
</div>

<div class="mb-10 w-full bg-gradient-to-r from-[#18181b] via-[#202024] to-[#18181b] border-y border-white/5 h-12 flex items-center relative overflow-hidden">
    <div class="absolute left-0 h-full bg-[#18181b] z-20 flex items-center px-4 md:px-6 border-r border-white/5 shadow-[5px_0_20px_rgba(0,0,0,0.8)]">
        <div class="flex items-center gap-2">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
            </span>
            <span class="text-xs font-bold text-slate-200 tracking-wider">LIVE INFO</span>
        </div>
    </div>

    <div class="flex animate-marquee whitespace-nowrap pl-40 md:pl-48 items-center gap-8">
        <% if (typeof updates !== 'undefined') { %>
            <% updates.forEach(update => { %>
                <div class="flex items-center gap-3">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded border 
                        <%= update.type === 'MAINTENANCE' ? 'bg-red-500/10 text-red-400 border-red-500/20' : 
                            update.type === 'EVENT' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : 
                            'bg-green-500/10 text-green-400 border-green-500/20' %>">
                        <%= update.type %>
                    </span>
                    <span class="text-sm text-slate-300 font-medium hover:text-white cursor-pointer transition-colors"><%= update.title %></span>
                    <span class="text-xs text-slate-600">|</span>
                </div>
            <% }) %>
            <% updates.forEach(update => { %>
                <div class="flex items-center gap-3">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded border 
                        <%= update.type === 'MAINTENANCE' ? 'bg-red-500/10 text-red-400 border-red-500/20' : 
                            update.type === 'EVENT' ? 'bg-purple-500/10 text-purple-400 border-purple-500/20' : 
                            'bg-green-500/10 text-green-400 border-green-500/20' %>">
                        <%= update.type %>
                    </span>
                    <span class="text-sm text-slate-300 font-medium"><%= update.title %></span>
                    <span class="text-xs text-slate-600">|</span>
                </div>
            <% }) %>
        <% } %>
    </div>
    <div class="absolute right-0 top-0 h-full w-20 bg-gradient-to-l from-[#18181b] to-transparent z-10 pointer-events-none"></div>
</div>

<section class="mb-20 reveal">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h2 class="text-3xl font-bold text-white">Update <span class="text-purple-500">Center</span></h2>
            <p class="text-slate-400 text-sm">Berita terbaru seputar game & server.</p>
        </div>
        <a href="/news" class="text-sm font-bold text-cyan-400 hover:text-cyan-300 transition flex items-center gap-1">
            Lihat Semua <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% if (typeof updates !== 'undefined' && updates.length > 0) { %>
            <% updates.forEach(item => { 
                let badgeColor = 'bg-slate-500';
                if(item.type === 'MAINTENANCE') badgeColor = 'bg-red-500';
                if(item.type === 'EVENT') badgeColor = 'bg-green-500';
                if(item.type === 'UPDATE') badgeColor = 'bg-blue-500';
                if(item.type === 'PROMO') badgeColor = 'bg-yellow-500 text-black';
            %>
                <a href="/news/<%= item.slug %>" class="group relative bg-[#18181b] border border-white/10 rounded-2xl overflow-hidden hover:-translate-y-1 transition-all duration-300 hover:border-purple-500/50 hover:shadow-lg hover:shadow-purple-500/10">
                    <div class="p-6 h-full flex flex-col">
                        <div class="flex justify-between items-start mb-4">
                            <span class="<%= badgeColor %> text-[10px] font-bold px-2 py-1 rounded text-white tracking-wider">
                                <%= item.type %>
                            </span>
                            <span class="text-slate-500 text-xs font-mono"><%= item.formatted_date %></span>
                        </div>
                        
                        <h3 class="text-white font-bold text-lg mb-2 line-clamp-2 group-hover:text-purple-400 transition-colors">
                            <%= item.title %>
                        </h3>
                        
                        <div class="text-slate-400 text-sm line-clamp-3 mb-4 flex-grow">
                            <%- item.content.replace(/<[^>]*>?/gm, '') %> </div>

                        <div class="flex items-center text-purple-400 text-sm font-bold mt-auto">
                            Baca Selengkapnya
                            <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </div>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="col-span-full text-center py-10 text-slate-500">Belum ada update terbaru.</div>
        <% } %>
    </div>
</section>

<section class="mb-20">
    <div class="flex justify-between items-end mb-8 reveal">
        <div>
            <h2 class="text-2xl font-bold text-white">Hot <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-500 to-purple-500">Promo</span></h2>
            <p class="text-slate-400 text-xs mt-1">Penawaran terbatas, klaim sebelum habis!</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% if (typeof promos !== 'undefined') { %>
            <% promos.forEach((promo, index) => { %>
                <a href="<%= promo.link %>" 
                   class="group relative rounded-2xl overflow-hidden aspect-[16/7] md:aspect-[16/9] reveal border border-white/5 hover:border-pink-500/50 transition-all duration-300 shadow-lg shadow-black/50" 
                   data-delay="<%= index * 100 %>">
                   
                    <% if (promo.type === 'video') { %>
                        <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-700">
                            <source src="<%= promo.src %>" type="video/mp4">
                        </video>
                    <% } else { %>
                        <img src="<%= promo.src %>" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition duration-700">
                    <% } %>

                    <div class="absolute inset-0 bg-gradient-to-t from-[#09090b] via-[#09090b]/40 to-transparent opacity-90 group-hover:opacity-80 transition duration-500"></div>
                    
                    <div class="absolute bottom-0 left-0 p-6 w-full z-10">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="inline-block px-2 py-0.5 rounded bg-pink-600 text-white text-[10px] font-bold uppercase tracking-wider shadow-lg shadow-pink-600/40 animate-pulse">Hot</span>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-1 group-hover:text-pink-400 transition-colors"><%= promo.title %></h3>
                        <p class="text-slate-300 text-xs line-clamp-1 opacity-80 group-hover:opacity-100"><%= promo.desc %></p>
                    </div>
                </a>
            <% }) %>
        <% } %>
    </div>
</section>

<section class="mb-20" id="catalog">
    <div class="text-center mb-8 reveal">
        <h2 class="text-3xl font-bold text-white mb-2">Katalog <span class="text-cyan-400">Games</span></h2>
        <p class="text-slate-400 text-sm">Pilih kategori untuk menemukan game favoritmu.</p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-10 reveal no-scrollbar overflow-x-auto pb-4 px-4">
        <button onclick="filterGames('all', this)" 
                class="filter-btn active px-6 py-2 rounded-full text-sm font-bold transition-all duration-300 border border-cyan-500 bg-cyan-600 text-white shadow-[0_0_15px_rgba(6,182,212,0.5)]">
            Semua
        </button>

        <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(cat => { %>
                <button onclick="filterGames('<%= cat %>', this)" 
                        class="filter-btn px-6 py-2 rounded-full text-sm font-bold transition-all duration-300 border border-white/10 bg-[#18181b] text-slate-400 hover:bg-white/10 hover:text-white">
                    <%= cat %>
                </button>
            <% }) %>
        <% } %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="gameGrid">
        <% if (typeof games !== 'undefined' && games.length > 0) { %>
            <% games.forEach((game, index) => { %>
                <a href="/topup/<%= game.slug %>" 
                   class="group relative block h-full reveal game-card-item" 
                   data-category="<%= game.category %>"
                   data-delay="<%= index * 50 %>">
                   
                    <div class="absolute -inset-0.5 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-2xl blur opacity-0 group-hover:opacity-60 transition duration-500"></div>
                    
                    <div class="relative h-full bg-[#18181b] rounded-xl overflow-hidden border border-white/10 group-hover:border-transparent transition-all duration-300 flex flex-col shadow-lg">
                        
                        <div class="aspect-video overflow-hidden relative bg-black/50">
                            <img src="/images/games/<%= game.thumbnail %>" 
                                 onerror="this.src='https://placehold.co/600x337/1e293b/FFF?text=<%= game.name %>'"
                                 alt="<%= game.name %>" 
                                 class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                
                            <div class="absolute inset-0 bg-gradient-to-t from-[#18181b] via-transparent to-transparent opacity-90 pointer-events-none"></div>
                            
                            <div class="absolute top-2 left-2 px-2 py-1 bg-black/60 backdrop-blur-md rounded-lg border border-yellow-500/30 flex items-center gap-1 z-10">
                                <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                <span class="text-xs font-bold text-white"><%= Number(game.rating).toFixed(1) %></span>
                            </div>

                            <div class="absolute top-2 right-2 px-2 py-1 bg-black/60 backdrop-blur-md rounded text-[10px] text-white border border-white/10 font-mono z-10">
                                <%= game.developer || 'OFFICIAL' %>
                            </div>
                        </div>

                        <div class="p-4 mt-auto relative z-10 bg-gradient-to-t from-[#18181b] to-transparent pt-6 flex-grow">
                            <h3 class="text-white font-bold text-lg truncate group-hover:text-cyan-400 transition-colors"><%= game.name %></h3>
                            <div class="flex justify-between items-center mt-2">
                                <span class="text-[10px] text-slate-400 font-mono bg-white/5 px-2 py-0.5 rounded">INSTANT</span>
                                <span class="w-6 h-6 rounded-full bg-cyan-500/20 flex items-center justify-center text-cyan-400 group-hover:bg-cyan-500 group-hover:text-white transition-colors">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            <% }); %>
        <% } else { %>
            <div class="col-span-full text-center py-20 bg-[#18181b] rounded-2xl border border-dashed border-white/10">
                <p class="text-slate-500">Belum ada game yang tersedia.</p>
            </div>
        <% } %>
    </div>
    
    <div id="noGamesMsg" class="hidden text-center py-20">
        <p class="text-slate-500 text-lg">Tidak ada game di kategori ini.</p>
    </div>
</section>

<section class="mb-20 reveal border-t border-white/5 pt-16">
    <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-white mb-2">Apa Kata <span class="text-yellow-400">Mereka?</span></h2>
        <p class="text-slate-400 text-sm">Ulasan asli dari para gamers ZenithPrime.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
            <% reviews.forEach(review => { %>
                <div class="bg-[#18181b] border border-white/10 p-6 rounded-2xl relative hover:border-yellow-500/30 transition duration-300">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-500 flex items-center justify-center text-white font-bold text-lg shadow-lg">
                            <%= review.user_name.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <h4 class="text-white font-bold text-sm"><%= review.user_name %></h4>
                            <p class="text-slate-500 text-xs">Top Up <%= review.game_name %></p>
                        </div>
                    </div>
                    
                    <div class="flex text-yellow-400 text-sm mb-3">
                        <% for(let i=0; i<5; i++) { %>
                            <span><%= i < review.rating ? '★' : '☆' %></span>
                        <% } %>
                    </div>

                    <p class="text-slate-300 text-sm leading-relaxed italic">"<%= review.comment %>"</p>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full text-center text-slate-500 py-10 bg-[#18181b] rounded-xl border border-dashed border-white/10">
                Belum ada ulasan saat ini. Jadilah yang pertama!
            </div>
        <% } %>
    </div>
</section>

<script>
    function filterGames(category, btnElement) {
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('bg-cyan-600', 'text-white', 'border-cyan-500', 'shadow-[0_0_15px_rgba(6,182,212,0.5)]');
            btn.classList.add('bg-[#18181b]', 'text-slate-400', 'border-white/10');
        });

        btnElement.classList.remove('bg-[#18181b]', 'text-slate-400', 'border-white/10');
        btnElement.classList.add('bg-cyan-600', 'text-white', 'border-cyan-500', 'shadow-[0_0_15px_rgba(6,182,212,0.5)]');

        const allGames = document.querySelectorAll('.game-card-item');
        let visibleCount = 0;

        allGames.forEach(card => {
            const cardCategory = card.getAttribute('data-category');

            if (category === 'all' || cardCategory === category) {
                card.style.display = 'block';
                setTimeout(() => {
                    card.classList.remove('opacity-0', 'scale-95');
                    card.classList.add('opacity-100', 'scale-100');
                }, 50);
                visibleCount++;
            } else {
                card.classList.add('opacity-0', 'scale-95');
                card.classList.remove('opacity-100', 'scale-100');
                setTimeout(() => {
                    card.style.display = 'none';
                }, 300);
            }
        });

        const noMsg = document.getElementById('noGamesMsg');
        if (visibleCount === 0) {
            noMsg.classList.remove('hidden');
        } else {
            noMsg.classList.add('hidden');
        }
    }

    document.getElementById('searchGame').addEventListener('keyup', function(e) {
        const term = e.target.value.toLowerCase();
        
        if (term.length > 0) {
            document.getElementById('catalog').scrollIntoView({ behavior: 'smooth' });
        }

        const cards = document.querySelectorAll('.game-card-item');
        cards.forEach(card => {
            const title = card.querySelector('h3').innerText.toLowerCase();
            if (title.includes(term)) {
                card.style.display = 'block';
                setTimeout(() => card.classList.add('opacity-100', 'scale-100'), 50);
            } else {
                card.style.display = 'none';
                card.classList.remove('opacity-100', 'scale-100');
            }
        });
    });
</script>