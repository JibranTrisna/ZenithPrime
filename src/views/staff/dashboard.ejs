<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6">

    <!-- Unified Staff Header -->
    <%- include('../partials/staff_header') %>

    <!-- Flash Notifications -->
    <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
        <div class="mb-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs sm:text-sm font-semibold flex items-center gap-2">
            <span>✅</span>
            <span><%= success_msg %></span>
        </div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
        <div class="mb-6 p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-300 text-xs sm:text-sm font-semibold flex items-center gap-2">
            <span>⚠️</span>
            <span><%= error_msg %></span>
        </div>
    <% } %>

    <!-- Quick Operations Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
        
        <!-- Pending Top Up Card -->
        <div class="p-6 rounded-3xl bg-[#121217] border border-yellow-500/20 relative overflow-hidden flex flex-col justify-between shadow-xl">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-yellow-400">Antrian Top Up</span>
                    <h3 class="text-3xl font-black text-white mt-1 font-mono"><%= pendingOrders.length %></h3>
                    <p class="text-[11px] text-slate-500 mt-1">Perlu diverifikasi & dikirim ke user</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 flex items-center justify-center text-xl">
                    ⏳
                </div>
            </div>
        </div>

        <!-- Joki Portal Card -->
        <a href="/staff/joki" class="p-6 rounded-3xl bg-[#121217] border border-cyan-500/20 hover:border-cyan-500/50 transition-all flex flex-col justify-between shadow-xl group">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-cyan-400">Joki Game Workspace</span>
                    <h3 class="text-lg font-bold text-white mt-1 group-hover:text-cyan-300 transition">Ambil Tugas Joki</h3>
                    <p class="text-[11px] text-slate-500 mt-1">Push rank, GB winrate, & party mabar</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center text-xl group-hover:scale-110 transition">
                    🛡️
                </div>
            </div>
            <div class="mt-4 flex items-center gap-1.5 text-xs text-cyan-400 font-semibold">
                <span>Buka Antrian Penjoki</span>
                <span>→</span>
            </div>
        </a>

        <!-- Live CS Chat Desk -->
        <a href="/staff/chat" class="p-6 rounded-3xl bg-[#121217] border border-indigo-500/20 hover:border-indigo-500/50 transition-all flex flex-col justify-between shadow-xl group">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-400">Live CS Chat Desk</span>
                    <h3 class="text-lg font-bold text-white mt-1 group-hover:text-indigo-300 transition">Layanan Konsumen</h3>
                    <p class="text-[11px] text-slate-500 mt-1">Balas pesan pelanggan & eskalasi AI</p>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center text-xl group-hover:scale-110 transition">
                    💬
                </div>
            </div>
            <div class="mt-4 flex items-center gap-1.5 text-xs text-indigo-400 font-semibold">
                <span>Masuk ke Room Chat</span>
                <span>→</span>
            </div>
        </a>
    </div>

    <!-- Antrian Pesanan Masuk (Top Up Queue) -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl overflow-hidden shadow-2xl mb-8">
        <div class="p-6 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full bg-yellow-400 animate-pulse"></span>
                <div>
                    <h3 class="font-bold text-white text-base">Antrian Pesanan Top Up Masuk</h3>
                    <p class="text-slate-500 text-xs">Pesanan baru yang siap dikirim dan diselesaikan oleh staff.</p>
                </div>
            </div>

            <!-- Search box for pending queue -->
            <div class="relative w-full sm:w-64">
                <input type="text" id="pendingSearchInput" onkeyup="searchPendingQueue()" placeholder="Cari ID, user, game, target..." 
                       class="w-full pl-9 pr-4 py-2 rounded-xl bg-black/40 border border-white/10 text-xs text-white placeholder-slate-500 focus:border-cyan-400 outline-none transition">
                <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
        </div>

        <% if (pendingOrders.length === 0) { %>
            <div class="py-16 px-4 text-center text-slate-500">
                <div class="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center mx-auto mb-4 text-2xl text-emerald-400">
                    🎉
                </div>
                <h4 class="text-base font-bold text-white mb-1">Semua Antrian Bersih!</h4>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">Tidak ada pesanan top up pending saat ini. Kerja bagus tim!</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-white/[0.03] text-white uppercase font-bold text-[11px] border-b border-white/10">
                        <tr>
                            <th class="px-6 py-4">ID Transaksi & Waktu</th>
                            <th class="px-6 py-4">Nama Pelanggan</th>
                            <th class="px-6 py-4">Game & Produk</th>
                            <th class="px-6 py-4">Target Akun Game</th>
                            <th class="px-6 py-4 text-center">Aksi Pengerjaan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5" id="pendingTableBody">
                        <% pendingOrders.forEach(order => { %>
                        <tr class="hover:bg-white/[0.03] transition pending-row" data-search="<%= order.id %> <%= (order.user_name || '').toLowerCase() %> <%= (order.game_name || '').toLowerCase() %> <%= (order.product_name || '').toLowerCase() %> <%= order.target_id || '' %> <%= order.zone_id || '' %>">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-1.5 font-mono text-white font-bold text-sm">
                                    <span>#<%= order.id %></span>
                                    <button onclick="copyText('<%= order.id %>')" title="Salin ID" class="text-slate-500 hover:text-cyan-400 transition">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    </button>
                                </div>
                                <div class="text-[10px] text-slate-500 mt-0.5">
                                    <%= new Date(order.created_at).toLocaleString('id-ID', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' }) %>
                                </div>
                            </td>

                            <td class="px-6 py-4">
                                <div class="font-bold text-white"><%= order.user_name %></div>
                                <div class="text-[10px] text-slate-500 font-mono">User ID: <%= order.user_id %></div>
                            </td>

                            <td class="px-6 py-4">
                                <div class="text-white font-semibold text-xs"><%= order.product_name %></div>
                                <div class="text-[11px] text-cyan-400 font-medium mt-0.5"><%= order.game_name %></div>
                            </td>

                            <td class="px-6 py-4 font-mono">
                                <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-black/50 border border-white/10 text-white select-all">
                                    <span class="text-slate-400 text-[10px]">ID:</span>
                                    <span class="font-bold text-cyan-300"><%= order.target_id %></span>
                                    <% if (order.zone_id) { %>
                                        <span class="text-slate-400 text-[10px]">Zone:</span>
                                        <span class="text-amber-300 font-bold">(<%= order.zone_id %>)</span>
                                    <% } %>
                                    <button onclick="copyText('<%= order.target_id %><%= order.zone_id ? ` (${order.zone_id})` : '' %>')" title="Salin Target" class="text-slate-500 hover:text-white transition ml-1">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    </button>
                                </div>
                            </td>

                            <td class="px-6 py-4">
                                <div class="flex items-center justify-center gap-2">
                                    <form action="/staff/process" method="POST">
                                        <input type="hidden" name="id" value="<%= order.id %>">
                                        <input type="hidden" name="status" value="success">
                                        <button class="bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-xl text-xs font-bold transition shadow-lg shadow-emerald-600/20 flex items-center gap-1.5">
                                            <span>✓</span>
                                            <span>Proses Sukses</span>
                                        </button>
                                    </form>
                                    
                                    <form action="/staff/process" method="POST" onsubmit="return confirm('Yakin ingin membatalkan/menolak order #<%= order.id %>?');">
                                        <input type="hidden" name="id" value="<%= order.id %>">
                                        <input type="hidden" name="status" value="failed">
                                        <button class="bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white px-3 py-2 rounded-xl text-xs font-semibold transition border border-red-500/30" title="Tolak">
                                            ✕ Batal
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Riwayat Pengerjaan Terakhir -->
    <div class="bg-[#121217] border border-white/10 rounded-3xl p-6 shadow-xl">
        <h3 class="text-sm font-bold text-white mb-4 flex items-center gap-2">
            <span>📜</span>
            <span>Riwayat Pengerjaan Terakhir</span>
        </h3>
        <div class="space-y-2.5">
            <% if (recentHistory.length === 0) { %>
                <p class="text-xs text-slate-500">Belum ada riwayat pengerjaan transaksi.</p>
            <% } else { %>
                <% recentHistory.forEach(h => { %>
                    <div class="flex items-center justify-between text-xs p-3 rounded-2xl bg-black/30 border border-white/5 hover:border-white/10 transition">
                        <div class="flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full <%= h.status === 'success' ? 'bg-emerald-400' : 'bg-red-400' %>"></span>
                            <div>
                                <span class="text-white font-bold">#<%= h.id %></span>
                                <span class="text-slate-400 mx-1">•</span>
                                <span class="text-slate-300"><%= h.user_name %></span>
                                <span class="text-slate-500 text-[11px] ml-1">(<%= h.product_name %>)</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-mono text-[11px] text-slate-500"><%= new Date(h.updated_at || h.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase
                                <%= h.status === 'success' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20' %>">
                                <%= h.status %>
                            </span>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>

<!-- Copy Toast Notification -->
<div id="staffToast" class="fixed bottom-6 right-6 z-50 bg-[#18181b] border border-cyan-500/30 text-cyan-300 px-4 py-2.5 rounded-xl shadow-2xl text-xs font-semibold flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <span>📋</span>
    <span id="staffToastText">Berhasil disalin!</span>
</div>

<script>
    function searchPendingQueue() {
        const query = (document.getElementById('pendingSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.pending-row');
        rows.forEach(r => {
            const data = (r.getAttribute('data-search') || '').toLowerCase();
            if (!query || data.includes(query)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function copyText(val) {
        navigator.clipboard.writeText(val).then(() => {
            const toast = document.getElementById('staffToast');
            const toastText = document.getElementById('staffToastText');
            toastText.innerText = `"${val}" berhasil disalin!`;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        });
    }
</script>