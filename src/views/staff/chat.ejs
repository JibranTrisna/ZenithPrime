<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6">

    <!-- Unified Staff Header -->
    <%- include('../partials/staff_header') %>

    <style>
        @keyframes pulse-glow-red {
            0%, 100% { box-shadow: 0 0 15px rgba(239, 68, 68, 0.4); border-color: rgba(239, 68, 68, 0.8); }
            50% { box-shadow: 0 0 25px rgba(239, 68, 68, 0.7); border-color: #ef4444; }
        }
        @keyframes flash-red {
            0% { background-color: rgba(220, 38, 38, 0.2); border-left-color: #dc2626; }
            50% { background-color: rgba(220, 38, 38, 0.45); border-left-color: #ef4444; }
            100% { background-color: rgba(220, 38, 38, 0.2); border-left-color: #dc2626; }
        }
        .notification-active {
            animation: flash-red 1.5s infinite ease-in-out !important;
            border-left: 4px solid #ef4444 !important;
        }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #121217; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #27272a; border-radius: 9999px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #3f3f46; }
    </style>

    <!-- Top KPI Bar for Live CS & Complaint Triage -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-[#121217] border border-red-500/30 rounded-2xl p-4 flex items-center justify-between shadow-xl relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-20 h-20 bg-red-500/10 rounded-full blur-xl group-hover:scale-125 transition-transform"></div>
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Butuh Follow Up (Keluhan)</p>
                <h3 class="text-2xl font-extrabold text-red-400 mt-1" id="stat-complaints"><%= stats.totalComplaints %></h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-red-500/15 border border-red-500/30 flex items-center justify-center text-red-400 text-lg">
                🚨
            </div>
        </div>

        <div class="bg-[#121217] border border-amber-500/30 rounded-2xl p-4 flex items-center justify-between shadow-xl relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-20 h-20 bg-amber-500/10 rounded-full blur-xl group-hover:scale-125 transition-transform"></div>
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Sedang Ditangani Staff</p>
                <h3 class="text-2xl font-extrabold text-amber-400 mt-1" id="stat-in-progress"><%= stats.totalInProgress %></h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 text-lg">
                ⏳
            </div>
        </div>

        <div class="bg-[#121217] border border-cyan-500/30 rounded-2xl p-4 flex items-center justify-between shadow-xl relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-20 h-20 bg-cyan-500/10 rounded-full blur-xl group-hover:scale-125 transition-transform"></div>
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Dipandu AI Assistant</p>
                <h3 class="text-2xl font-extrabold text-cyan-400 mt-1" id="stat-ai-handled"><%= stats.totalAiHandled %></h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-lg">
                🤖
            </div>
        </div>

        <div class="bg-[#121217] border border-emerald-500/30 rounded-2xl p-4 flex items-center justify-between shadow-xl relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-20 h-20 bg-emerald-500/10 rounded-full blur-xl group-hover:scale-125 transition-transform"></div>
            <div>
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Keluhan Selesai (Resolved)</p>
                <h3 class="text-2xl font-extrabold text-emerald-400 mt-1" id="stat-resolved"><%= stats.totalResolved %></h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-lg">
                ✅
            </div>
        </div>
    </div>

    <!-- Main Live CS Workspace (Queue & Active Chat) -->
    <div class="h-[680px] flex flex-col md:flex-row gap-6 relative">
        
        <!-- ======================================================== -->
        <!-- LEFT: Customer Queue & Filter Column                     -->
        <!-- ======================================================== -->
        <div class="w-full md:w-5/12 lg:w-4/12 bg-[#121217] border border-white/10 rounded-3xl overflow-hidden flex flex-col shadow-2xl">
            
            <!-- Queue Header & Search -->
            <div class="p-4 border-b border-white/10 bg-black/40 space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-white text-sm flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
                        <span>Antrian Live CS & AI</span>
                    </h3>
                    <span class="text-[10px] text-slate-400 font-mono bg-white/5 px-2.5 py-1 rounded-full border border-white/5">
                        <span id="queueCount"><%= tickets.length %></span> Sesi
                    </span>
                </div>

                <!-- Search Input -->
                <div class="relative">
                    <input type="text" id="queueSearch" placeholder="Cari nama, email, #TRX, #JK..." 
                           class="w-full bg-[#18181f] text-white text-xs rounded-xl px-3.5 py-2 pl-9 border border-white/10 focus:border-cyan-500 outline-none transition placeholder-slate-500">
                    <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <!-- Filter Tabs -->
                <div class="flex gap-1 overflow-x-auto custom-scrollbar pb-0.5 text-[11px] font-semibold">
                    <button type="button" onclick="setFilter('needs_followup')" id="tab-needs_followup" class="tab-btn px-2.5 py-1.5 rounded-lg bg-red-500/20 text-red-300 border border-red-500/40 whitespace-nowrap transition flex items-center gap-1.5">
                        <span>🚨 Follow Up</span>
                        <span class="px-1.5 py-0.2 rounded-full bg-red-600 text-white text-[9px] font-bold" id="badge-tab-complaints"><%= stats.totalComplaints %></span>
                    </button>
                    <button type="button" onclick="setFilter('in_progress')" id="tab-in_progress" class="tab-btn px-2.5 py-1.5 rounded-lg bg-white/5 text-slate-400 hover:text-white whitespace-nowrap transition flex items-center gap-1.5">
                        <span>⏳ Ditangani</span>
                    </button>
                    <button type="button" onclick="setFilter('all')" id="tab-all" class="tab-btn px-2.5 py-1.5 rounded-lg bg-white/5 text-slate-400 hover:text-white whitespace-nowrap transition">
                        💬 Semua
                    </button>
                    <button type="button" onclick="setFilter('resolved')" id="tab-resolved" class="tab-btn px-2.5 py-1.5 rounded-lg bg-white/5 text-slate-400 hover:text-white whitespace-nowrap transition">
                        ✅ Selesai
                    </button>
                </div>
            </div>
            
            <!-- Queue List Feed -->
            <div class="flex-1 overflow-y-auto p-2 space-y-2 custom-scrollbar" id="userList">
                <% if (tickets.length > 0) { %>
                    <% tickets.forEach(ticket => { %>
                        <div id="card-<%= ticket.room_id %>" 
                             data-status="<%= ticket.status %>"
                             data-category="<%= ticket.category %>"
                             data-search="<%= (ticket.user_name + ' ' + (ticket.user_email || '') + ' ' + (ticket.order_id || '') + ' ' + (ticket.summary || '')).toLowerCase() %>"
                             onclick="openChat('<%= ticket.room_id %>', '<%= ticket.user_name %>', '<%= ticket.user_email %>')"
                             class="queue-item cursor-pointer w-full text-left p-3.5 rounded-2xl bg-[#181820]/80 hover:bg-[#1f1f2a] border border-white/5 hover:border-cyan-500/30 transition-all duration-200 relative group overflow-hidden border-l-4 <%= ticket.status === 'needs_followup' ? 'border-l-red-500 bg-red-950/10' : (ticket.status === 'in_progress' ? 'border-l-amber-500' : (ticket.status === 'resolved' ? 'border-l-emerald-500' : 'border-l-cyan-500/50')) %>">
                            
                            <!-- Unread Counter Badge -->
                            <span id="badge-<%= ticket.room_id %>" 
                                  class="absolute top-3 right-3 bg-red-600 text-white text-[10px] font-bold min-w-[20px] h-[20px] px-1 items-center justify-center rounded-full border border-[#18181b] shadow-md z-20 hidden">
                                0
                            </span>

                            <div class="flex items-start gap-3">
                                <!-- User Initial Avatar -->
                                <div class="w-10 h-10 rounded-xl <%= ticket.status === 'needs_followup' ? 'bg-red-900/40 text-red-300 border-red-500/40' : 'bg-slate-800 text-white border-white/10' %> border flex items-center justify-center font-bold text-sm shrink-0 shadow-md">
                                    <%= (ticket.user_name || 'U').charAt(0).toUpperCase() %>
                                </div>

                                <div class="flex-1 min-w-0">
                                    <!-- User Name & Urgency Tag -->
                                    <div class="flex items-center justify-between gap-1 mb-1">
                                        <h4 class="text-xs font-bold text-white truncate"><%= ticket.user_name %></h4>
                                        <span class="text-[9px] font-mono shrink-0 <%= ticket.urgency === 'urgent' ? 'bg-red-500/20 text-red-300 border border-red-500/40 px-1.5 py-0.5 rounded font-bold' : (ticket.urgency === 'high' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40 px-1.5 py-0.5 rounded font-bold' : 'text-slate-500') %>">
                                            <%= ticket.urgency.toUpperCase() %>
                                        </span>
                                    </div>

                                    <!-- Category & Status Badges -->
                                    <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                                        <span class="text-[9px] px-2 py-0.5 rounded-md font-semibold <%= ticket.status === 'needs_followup' ? 'bg-red-500/20 text-red-300 border border-red-500/30' : (ticket.status === 'in_progress' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : (ticket.status === 'resolved' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30')) %>">
                                            <%= ticket.status === 'needs_followup' ? '🚨 Butuh Follow Up' : (ticket.status === 'in_progress' ? '⏳ Sedang Ditangani' : (ticket.status === 'resolved' ? '✅ Selesai' : '🤖 AI Assisted')) %>
                                        </span>

                                        <% if (ticket.order_id) { %>
                                            <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">
                                                #<%= ticket.order_id %>
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- Summary / Latest Message -->
                                    <p class="text-[11px] text-slate-300 font-medium truncate mb-0.5" title="<%= ticket.summary %>">
                                        <%= ticket.summary %>
                                    </p>
                                    
                                    <p class="text-[10px] text-slate-500 truncate font-mono">
                                        <% if (ticket.latest_message) { %>
                                            <%= ticket.latest_is_staff ? '👨‍💼 Staf: ' : (ticket.latest_is_ai ? '🤖 AI: ' : '👤 User: ') %>
                                            <%= ticket.latest_message %>
                                        <% } else { %>
                                            <%= ticket.last_user_message || 'Belum ada pesan terbaru' %>
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div id="no-chat-msg" class="flex flex-col items-center justify-center h-48 text-slate-500 text-center px-4">
                        <span class="text-4xl mb-2">💬</span>
                        <p class="text-xs font-semibold text-slate-400">Belum ada antrian chat aktif.</p>
                        <p class="text-[10px] text-slate-500 mt-1">Setiap pengguna yang chat dengan AI CS akan otomatis terhubung ke inbox ini.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ======================================================== -->
        <!-- RIGHT: Active Chat Conversation & Triage Workspace       -->
        <!-- ======================================================== -->
        <div class="w-full md:w-7/12 lg:w-8/12 bg-[#121217] border border-white/10 rounded-3xl overflow-hidden flex flex-col relative shadow-2xl">
            
            <!-- Empty State Overlay -->
            <div id="emptyState" class="absolute inset-0 flex flex-col items-center justify-center text-slate-500 z-10 bg-[#121217]">
                <div class="w-20 h-20 bg-gradient-to-tr from-cyan-500/10 to-indigo-500/10 border border-cyan-500/20 rounded-3xl flex items-center justify-center mb-4 shadow-xl">
                    <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                </div>
                <h4 class="text-white font-bold text-base mb-1">Pilih Pelanggan dari Antrian</h4>
                <p class="text-xs text-slate-400 max-w-sm text-center leading-relaxed">
                    Klik salah satu tiket keluhan atau sesi percakapan di sebelah kiri untuk melihat pesan, mengambil alih intervensi dari AI, dan memberikan solusi follow up.
                </p>
            </div>

            <!-- Active Chat Header -->
            <div class="p-4 border-b border-white/10 bg-black/40 flex flex-wrap justify-between items-center gap-3 z-20">
                <div class="flex items-center gap-3">
                    <div class="relative">
                        <div class="w-10 h-10 rounded-xl bg-cyan-600/20 border border-cyan-500/40 flex items-center justify-center font-bold text-cyan-300 text-sm shadow-md" id="currentChatAvatar">
                            U
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse absolute -bottom-0.5 -right-0.5 border-2 border-[#121217]"></span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-white text-sm" id="currentChatUser">Chat Room</h3>
                            <span id="currentStatusBadge" class="text-[9px] px-2 py-0.5 rounded-full font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                                AI Active
                            </span>
                        </div>
                        <p class="text-[10px] text-slate-400 font-mono" id="currentChatSub">Pilih percakapan</p>
                    </div>
                </div>

                <!-- Action Control Buttons: Takeover, Handover, Resolve & Drawer -->
                <div class="flex items-center gap-2 flex-wrap">
                    <!-- Take Over Button (Stops AI) -->
                    <button type="button" id="btnTakeover" onclick="handleTakeover()" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white text-xs font-bold shadow-md shadow-amber-900/20 flex items-center gap-1.5 transition">
                        <span>⚡</span>
                        <span>Ambil Alih (Pause AI)</span>
                    </button>

                    <!-- Handover to AI Button -->
                    <button type="button" id="btnHandoverAi" onclick="handleHandoverAi()" class="hidden px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-cyan-300 text-xs font-semibold border border-cyan-500/30 flex items-center gap-1.5 transition">
                        <span>🔄</span>
                        <span>Kembalikan ke AI</span>
                    </button>

                    <!-- Resolve Ticket Button -->
                    <button type="button" id="btnResolve" onclick="handleResolveTicket()" class="px-3 py-1.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 text-xs font-semibold border border-emerald-500/30 flex items-center gap-1.5 transition">
                        <span>✅</span>
                        <span>Selesaikan</span>
                    </button>

                    <!-- Toggle Customer Details Drawer -->
                    <button type="button" onclick="toggleDrawer()" class="px-2.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white text-xs font-semibold border border-white/10 transition" title="Detail Profil & Riwayat Transaksi">
                        <span>📊 Info</span>
                    </button>
                </div>
            </div>

            <!-- AI Complaint Intel Banner (Live Triage Snapshot) -->
            <div id="aiIntelBanner" class="bg-gradient-to-r from-red-950/40 via-[#181824] to-indigo-950/30 border-b border-red-500/20 px-4 py-2.5 flex items-center justify-between text-xs z-20">
                <div class="flex items-center gap-3 overflow-hidden">
                    <span class="px-2 py-0.5 rounded font-mono font-bold text-[9px] bg-red-500/20 text-red-300 border border-red-500/30 shrink-0" id="intelUrgency">
                        URGENT
                    </span>
                    <span class="font-bold text-white truncate text-xs flex items-center gap-1.5" id="intelSummary">
                        <span>🚨</span> <span id="intelSummaryText">Memuat ringkasan keluhan...</span>
                    </span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <span id="intelOrderIdBadge" class="hidden font-mono text-[10px] bg-white/10 px-2 py-0.5 rounded text-cyan-300 border border-cyan-500/30">
                        #TRX-0000
                    </span>
                </div>
            </div>

            <!-- Message List Feed -->
            <div id="staffMessagesList" class="flex-1 overflow-y-auto p-6 space-y-3 bg-[#08080a] custom-scrollbar"></div>

            <!-- Canned Quick Follow Up Solutions Bar -->
            <div class="px-4 py-2 bg-black/60 border-t border-white/5 flex items-center gap-2 overflow-x-auto text-[11px] z-20 custom-scrollbar">
                <span class="text-cyan-400 font-bold shrink-0 flex items-center gap-1">
                    <span>⚡</span> Solusi Cepat:
                </span>
                <button type="button" onclick="insertCanned('Halo Kak! Kami dari Tim CS ZenithPrime siap membantu menyelesaikan kendala Anda. Ada yang bisa kami bantu? 👋')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white shrink-0 border border-white/5 transition">Sapaan 👋</button>
                <button type="button" onclick="insertCanned('Halo Kak, kendala pesanan Kakak saat ini sedang kami follow up secara prioritas ke server provider pusat. Mohon ditunggu 3-5 menit ya Kak. ⏳')" class="px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 shrink-0 border border-amber-500/20 transition">Follow Up Provider ⏳</button>
                <button type="button" onclick="insertCanned('Untuk memproses verifikasi saldo yang terpotong, mohon lampirkan tangkapan layar (screenshot) mutasi transfer atau bukti pembayaran Kakak ya. 📑')" class="px-2.5 py-1 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 shrink-0 border border-cyan-500/20 transition">Minta Bukti Mutasi 📑</button>
                <button type="button" onclick="insertCanned('Baik Kak, data User ID game Anda telah kami perbarui di sistem antrean pengiriman. Item akan segera dikirim ulang oleh sistem. 🎮')" class="px-2.5 py-1 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 shrink-0 border border-purple-500/20 transition">Koreksi Data ID 🎮</button>
                <button type="button" onclick="insertCanned('Kabar baik Kak! Kendala pada pesanan Anda telah berhasil diselesaikan dan item sudah masuk ke akun game Kakak. Silakan dicek kembali ya. 🎉')" class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 shrink-0 border border-emerald-500/20 transition">Order Berhasil 🎉</button>
                <button type="button" onclick="insertCanned('Pengajuan refund untuk transaksi ini telah kami setujui dan dana telah dikembalikan ke saldo akun ZenithPrime Kakak. Terima kasih atas kesabarannya! 💰')" class="px-2.5 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 shrink-0 border border-emerald-500/20 transition">Refund Saldo 💰</button>
            </div>

            <!-- Chat Input Form -->
            <form id="staffChatForm" class="p-4 bg-[#121217] border-t border-white/10 flex gap-3 z-20">
                <input type="hidden" id="currentRoomId">
                <input type="text" id="staffChatInput" disabled autocomplete="off" placeholder="Pilih chat dari antrian terlebih dahulu..." 
                       class="flex-1 bg-black/60 text-white rounded-xl px-4 py-3 border border-white/10 focus:border-cyan-500 outline-none transition disabled:opacity-50 disabled:cursor-not-allowed text-xs">
                <button type="submit" id="staffSendBtn" disabled 
                        class="bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 disabled:from-slate-800 disabled:to-slate-800 disabled:text-slate-500 text-white px-5 rounded-xl font-bold transition shadow-lg shadow-cyan-600/20 text-xs flex items-center gap-1.5">
                    <span>Kirim Solusi</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </form>

            <!-- ==================================================== -->
            <!-- SLIDE-OVER DRAWER: Customer & Order Insights         -->
            <!-- ==================================================== -->
            <div id="customerDrawer" class="absolute top-0 right-0 w-80 h-full bg-[#14141c]/98 backdrop-blur-2xl border-l border-white/10 shadow-2xl z-30 transform translate-x-full transition-transform duration-300 flex flex-col">
                <div class="p-4 border-b border-white/10 flex justify-between items-center bg-black/40">
                    <h4 class="font-bold text-white text-xs flex items-center gap-1.5">
                        <span>📊</span> Insight Pelanggan
                    </h4>
                    <button type="button" onclick="toggleDrawer()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-white/5 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-4 custom-scrollbar text-xs">
                    <!-- Profile Info Card -->
                    <div class="bg-black/40 border border-white/5 p-3 rounded-2xl space-y-1.5">
                        <div class="font-bold text-white text-sm" id="drawerCustName">-</div>
                        <div class="text-[11px] text-slate-400 font-mono" id="drawerCustEmail">-</div>
                        <div class="text-[10px] text-cyan-400 font-mono" id="drawerCustJoined">Terdaftar: -</div>
                    </div>

                    <!-- 3 Latest Top Up Orders -->
                    <div>
                        <div class="font-bold text-slate-300 text-[11px] uppercase tracking-wider mb-2 flex items-center gap-1">
                            <span>🎮</span> 3 Order Top Up Terakhir
                        </div>
                        <div id="drawerOrdersList" class="space-y-2">
                            <div class="text-slate-500 text-center py-4 text-[10px]">Memuat riwayat transaksi...</div>
                        </div>
                    </div>

                    <!-- 3 Latest Joki Orders -->
                    <div>
                        <div class="font-bold text-slate-300 text-[11px] uppercase tracking-wider mb-2 flex items-center gap-1">
                            <span>⚔️</span> 3 Order Joki Terakhir
                        </div>
                        <div id="drawerJokiList" class="space-y-2">
                            <div class="text-slate-500 text-center py-4 text-[10px]">Memuat riwayat joki...</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Audio Chime Alert for Incoming Complaint -->
<audio id="staffNotifSound" src="https://cdn.freesound.org/previews/536/536108_11679093-lq.mp3" preload="auto"></audio>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const staffId = '<%= user.id %>';
    const messagesList = document.getElementById('staffMessagesList');
    const notifSound = document.getElementById('staffNotifSound');
    
    let currentFilter = 'needs_followup'; // Default tab: Butuh Follow Up
    let activeRoomTicket = null;
    let unreadData = {};

    // Hubungkan staf ke staff_room
    socket.emit('staff_join');
    socket.emit('join_staff_room');

    // Filter antrian berdasarkan tab
    function setFilter(filterType) {
        currentFilter = filterType;
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('bg-red-500/20', 'text-red-300', 'border-red-500/40', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'bg-white/10', 'text-white');
            btn.classList.add('bg-white/5', 'text-slate-400');
        });

        const activeTab = document.getElementById(`tab-${filterType}`);
        if (activeTab) {
            activeTab.classList.remove('bg-white/5', 'text-slate-400');
            if (filterType === 'needs_followup') {
                activeTab.classList.add('bg-red-500/20', 'text-red-300', 'border-red-500/40');
            } else {
                activeTab.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
            }
        }

        applyFilters();
    }

    function applyFilters() {
        const query = document.getElementById('queueSearch').value.toLowerCase().trim();
        const items = document.querySelectorAll('.queue-item');
        let visibleCount = 0;

        items.forEach(item => {
            const status = item.getAttribute('data-status');
            const searchData = item.getAttribute('data-search') || '';

            let matchesTab = false;
            if (currentFilter === 'all') matchesTab = true;
            else if (currentFilter === status) matchesTab = true;

            let matchesSearch = true;
            if (query && !searchData.includes(query)) matchesSearch = false;

            if (matchesTab && matchesSearch) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        const queueCount = document.getElementById('queueCount');
        if (queueCount) queueCount.innerText = visibleCount;
    }

    document.getElementById('queueSearch').addEventListener('input', applyFilters);

    // Initial Filter Run
    setFilter('needs_followup');

    // Template Canned Response
    function insertCanned(text) {
        const input = document.getElementById('staffChatInput');
        if (!input.disabled) {
            input.value = text;
            input.focus();
        }
    }

    // Toggle Drawer Detail
    function toggleDrawer() {
        const drawer = document.getElementById('customerDrawer');
        if (drawer.classList.contains('translate-x-full')) {
            drawer.classList.remove('translate-x-full');
            loadCustomerDrawerData();
        } else {
            drawer.classList.add('translate-x-full');
        }
    }

    // Ambil Alih (Take Over - Pause AI)
    function handleTakeover() {
        const roomId = document.getElementById('currentRoomId').value;
        if (!roomId) return;
        socket.emit('ticket_takeover', { room_id: roomId });
        updateRoomUiTakeover(true);
    }

    // Kembalikan ke AI Assistant
    function handleHandoverAi() {
        const roomId = document.getElementById('currentRoomId').value;
        if (!roomId) return;
        socket.emit('ticket_handover_ai', { room_id: roomId });
        updateRoomUiTakeover(false);
    }

    // Selesaikan Tiket
    function handleResolveTicket() {
        const roomId = document.getElementById('currentRoomId').value;
        if (!roomId) return;
        const notes = prompt("Catatan penyelesaian (opsional):", "Keluhan telah diselesaikan oleh staf.");
        if (notes !== null) {
            socket.emit('ticket_resolve', { room_id: roomId, notes });
            const badge = document.getElementById('currentStatusBadge');
            if (badge) {
                badge.innerText = '✅ Selesai (Resolved)';
                badge.className = 'text-[9px] px-2 py-0.5 rounded-full font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
            }
        }
    }

    function updateRoomUiTakeover(isTakenOver) {
        const btnTakeover = document.getElementById('btnTakeover');
        const btnHandover = document.getElementById('btnHandoverAi');
        const badge = document.getElementById('currentStatusBadge');

        if (isTakenOver) {
            btnTakeover.classList.add('hidden');
            btnHandover.classList.remove('hidden');
            if (badge) {
                badge.innerText = '👨‍💼 Staf Aktif (AI Di-Pause)';
                badge.className = 'text-[9px] px-2 py-0.5 rounded-full font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30';
            }
        } else {
            btnTakeover.classList.remove('hidden');
            btnHandover.classList.add('hidden');
            if (badge) {
                badge.innerText = '🤖 AI Active';
                badge.className = 'text-[9px] px-2 py-0.5 rounded-full font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';
            }
        }
    }

    // Tangani Notifikasi Pesan / Keluhan Baru dari Socket
    socket.on('staff_notification', (data) => {
        const currentOpenRoom = document.getElementById('currentRoomId').value;
        
        // Mainkan audio jika keluhan baru masuk
        if (data.ticket && data.ticket.status === 'needs_followup') {
            try {
                notifSound.currentTime = 0;
                notifSound.play().catch(e => console.log('Audio autoplay blocked'));
            } catch(e) {}
        }

        // Update atau tambahkan card di queue antrian
        let card = document.getElementById(`card-${data.room_id}`);
        if (!card) {
            const noMsg = document.getElementById('no-chat-msg');
            if (noMsg) noMsg.remove();

            card = document.createElement('div');
            card.id = `card-${data.room_id}`;
            card.onclick = () => openChat(data.room_id, data.user_name || 'Customer', data.user_email || '');
            document.getElementById('userList').prepend(card);
        }

        const ticket = data.ticket || {};
        card.setAttribute('data-status', ticket.status || 'ai_handled');
        card.setAttribute('data-category', ticket.category || 'GENERAL_QUERY');
        card.setAttribute('data-search', `${(data.user_name || '')} ${(data.user_email || '')} ${(ticket.order_id || '')} ${(ticket.summary || '')}`.toLowerCase());
        
        const isUrgent = ticket.urgency === 'urgent';
        card.className = `queue-item cursor-pointer w-full text-left p-3.5 rounded-2xl bg-[#181820]/80 hover:bg-[#1f1f2a] border border-white/5 hover:border-cyan-500/30 transition-all duration-200 relative group overflow-hidden border-l-4 ${ticket.status === 'needs_followup' ? 'border-l-red-500 bg-red-950/10 notification-active' : (ticket.status === 'in_progress' ? 'border-l-amber-500' : 'border-l-cyan-500/50')}`;

        card.innerHTML = `
            <span id="badge-${data.room_id}" class="absolute top-3 right-3 bg-red-600 text-white text-[10px] font-bold min-w-[20px] h-[20px] px-1 items-center justify-center rounded-full border border-[#18181b] shadow-md z-20 ${currentOpenRoom === data.room_id ? 'hidden' : 'flex'}">
                1
            </span>
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl ${ticket.status === 'needs_followup' ? 'bg-red-900/40 text-red-300 border-red-500/40' : 'bg-slate-800 text-white border-white/10'} border flex items-center justify-center font-bold text-sm shrink-0 shadow-md">
                    ${(data.user_name || 'U').charAt(0).toUpperCase()}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-1 mb-1">
                        <h4 class="text-xs font-bold text-white truncate">${data.user_name || 'Customer'}</h4>
                        <span class="text-[9px] font-mono shrink-0 ${isUrgent ? 'bg-red-500/20 text-red-300 border border-red-500/40 px-1.5 py-0.5 rounded font-bold' : 'text-slate-500'}">
                            ${(ticket.urgency || 'NORMAL').toUpperCase()}
                        </span>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                        <span class="text-[9px] px-2 py-0.5 rounded-md font-semibold ${ticket.status === 'needs_followup' ? 'bg-red-500/20 text-red-300 border border-red-500/30' : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'}">
                            ${ticket.status === 'needs_followup' ? '🚨 Butuh Follow Up' : (ticket.status === 'in_progress' ? '⏳ Sedang Ditangani' : '🤖 AI Assisted')}
                        </span>
                        ${ticket.order_id ? `<span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">#${ticket.order_id}</span>` : ''}
                    </div>
                    <p class="text-[11px] text-slate-300 font-medium truncate mb-0.5">${ticket.summary || data.message}</p>
                    <p class="text-[10px] text-slate-500 truncate font-mono">${data.is_staff ? '👨‍💼 Staf: ' : (data.is_ai ? '🤖 AI: ' : '👤 User: ')}${data.message}</p>
                </div>
            </div>
        `;

        if (currentOpenRoom !== data.room_id) {
            unreadData[data.room_id] = (unreadData[data.room_id] || 0) + 1;
            const badge = document.getElementById(`badge-${data.room_id}`);
            if (badge) {
                badge.innerText = unreadData[data.room_id];
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }
        }

        applyFilters();
    });

    // Tangani Update Tiket
    socket.on('ticket_updated', (data) => {
        const card = document.getElementById(`card-${data.room_id}`);
        if (card && data.ticket) {
            card.setAttribute('data-status', data.ticket.status);
            applyFilters();
        }
        const currentOpenRoom = document.getElementById('currentRoomId').value;
        if (currentOpenRoom === data.room_id && data.ticket) {
            updateRoomUiTakeover(data.ticket.is_ai_paused === 1);
        }
    });

    // Buka Room Percakapan
    async function openChat(roomId, userName, userEmail) {
        document.getElementById('emptyState').classList.add('hidden');
        document.getElementById('currentRoomId').value = roomId;
        document.getElementById('currentChatUser').innerText = userName;
        document.getElementById('currentChatSub').innerText = `${userEmail || ''} (${roomId})`;
        document.getElementById('currentChatAvatar').innerText = userName.charAt(0).toUpperCase();

        const input = document.getElementById('staffChatInput');
        const btn = document.getElementById('staffSendBtn');
        input.disabled = false;
        btn.disabled = false;
        input.placeholder = `Tulis solusi follow up untuk ${userName}...`;
        input.focus();

        const card = document.getElementById(`card-${roomId}`);
        if (card) {
            card.classList.remove('notification-active');
            unreadData[roomId] = 0;
            const badge = document.getElementById(`badge-${roomId}`);
            if (badge) badge.classList.add('hidden');
        }

        messagesList.innerHTML = '<div class="text-center text-slate-500 text-xs py-8">Memuat riwayat chat & intel...</div>';

        try {
            // Load detail tiket & user info
            const infoRes = await fetch(`/staff/api/chat/${roomId}/user-info`);
            const infoData = await infoRes.json();
            
            if (infoData.success && infoData.ticket) {
                activeRoomTicket = infoData.ticket;
                const t = infoData.ticket;
                
                // Update Intel Banner
                document.getElementById('intelUrgency').innerText = (t.urgency || 'NORMAL').toUpperCase();
                document.getElementById('intelSummaryText').innerText = t.summary || 'Tidak ada catatan keluhan khusus.';
                
                const orderBadge = document.getElementById('intelOrderIdBadge');
                if (t.order_id) {
                    orderBadge.innerText = `#${t.order_id}`;
                    orderBadge.classList.remove('hidden');
                } else {
                    orderBadge.classList.add('hidden');
                }

                updateRoomUiTakeover(t.is_ai_paused === 1);
            }

            // Load Chat Messages
            const res = await fetch(`/staff/api/chat/${roomId}`);
            const chats = await res.json();

            messagesList.innerHTML = '';
            chats.forEach(chat => {
                appendMessage(chat.message, chat.is_staff_reply ? 'staff' : (chat.is_ai ? 'ai' : 'user'));
            });
            scrollToBottom();
        } catch (err) {
            console.error("Open chat error:", err);
            messagesList.innerHTML = '<div class="text-center text-red-500 text-xs py-8">Gagal memuat pesan.</div>';
        }
    }

    // Submit Balasan Staff
    document.getElementById('staffChatForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const input = document.getElementById('staffChatInput');
        const message = input.value.trim();
        const roomId = document.getElementById('currentRoomId').value;

        if (message && roomId) {
            socket.emit('send_message', {
                room_id: roomId,
                message: message,
                is_staff: true
            });

            appendMessage(message, 'staff');
            input.value = '';
            scrollToBottom();
        }
    });

    // Tangani Pesan Masuk
    socket.on('receive_message', (data) => {
        const currentOpenRoom = document.getElementById('currentRoomId').value;
        if (data.room_id === currentOpenRoom) {
            appendMessage(data.message, data.is_staff ? 'staff' : (data.is_ai ? 'ai' : 'user'));
            scrollToBottom();
        }
    });

    function appendMessage(msg, sender) {
        const div = document.createElement('div');
        div.className = `flex ${sender === 'staff' ? 'justify-end' : 'justify-start'}`;
        
        let bg = 'bg-[#181820] text-slate-200 border border-white/10 rounded-bl-sm';
        let badge = '';

        if (sender === 'staff') {
            bg = 'bg-gradient-to-r from-cyan-600 to-indigo-600 text-white rounded-br-sm shadow-md shadow-cyan-900/20';
            badge = '<div class="text-[9px] text-cyan-200 font-bold mb-0.5 flex items-center gap-1"><span>👨‍💼</span> Staff Support (Anda)</div>';
        } else if (sender === 'ai') {
            bg = 'bg-[#151522] text-indigo-200 border border-indigo-500/30 rounded-bl-sm';
            badge = '<div class="text-[9px] text-indigo-400 font-bold mb-0.5 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>🤖 Zenith AI Assistant</div>';
        } else {
            badge = '<div class="text-[9px] text-slate-400 font-bold mb-0.5">👤 Pelanggan</div>';
        }
        
        div.innerHTML = `
            <div class="max-w-[75%] rounded-2xl px-4 py-2.5 text-xs leading-relaxed ${bg}">
                ${badge}
                <div class="break-words whitespace-pre-wrap">${formatSimpleMarkdown(msg)}</div>
            </div>
        `;
        messagesList.appendChild(div);
    }

    function formatSimpleMarkdown(text) {
        if (!text) return '';
        return text
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/`([^`]+)`/g, '<code class="bg-black/40 px-1 py-0.5 rounded text-cyan-300 font-mono text-[10px]">$1</code>');
    }

    function scrollToBottom() {
        messagesList.scrollTop = messagesList.scrollHeight;
    }

    // Load Data Drawer
    async function loadCustomerDrawerData() {
        const roomId = document.getElementById('currentRoomId').value;
        if (!roomId) return;

        try {
            const res = await fetch(`/staff/api/chat/${roomId}/user-info`);
            const data = await res.json();

            if (data.success) {
                document.getElementById('drawerCustName').innerText = data.customer.name;
                document.getElementById('drawerCustEmail').innerText = data.customer.email;
                document.getElementById('drawerCustJoined').innerText = `Terdaftar: ${new Date(data.customer.created_at).toLocaleDateString('id-ID')}`;

                const ordersContainer = document.getElementById('drawerOrdersList');
                if (data.recentTransactions && data.recentTransactions.length > 0) {
                    ordersContainer.innerHTML = data.recentTransactions.map(tx => `
                        <div class="bg-black/30 border border-white/5 p-2 rounded-xl text-[10px] space-y-1">
                            <div class="flex justify-between font-mono font-bold">
                                <span class="text-white">${tx.order_id}</span>
                                <span class="${tx.status === 'success' ? 'text-emerald-400' : (tx.status === 'pending' ? 'text-amber-400' : 'text-red-400')} uppercase font-bold">${tx.status}</span>
                            </div>
                            <div class="text-slate-400 truncate">${tx.game_name} - ${tx.product_name}</div>
                            <div class="text-cyan-300 font-mono font-semibold">Rp ${Number(tx.amount || 0).toLocaleString('id-ID')}</div>
                            <button type="button" onclick="insertCanned('Mengenai pesanan Anda #${tx.order_id} (${tx.product_name}): ')" class="text-[9px] text-cyan-400 hover:underline pt-0.5">Kutip ke Chat ↗</button>
                        </div>
                    `).join('');
                } else {
                    ordersContainer.innerHTML = '<div class="text-slate-500 text-[10px] text-center py-2">Belum ada transaksi top up.</div>';
                }

                const jokiContainer = document.getElementById('drawerJokiList');
                if (data.recentJoki && data.recentJoki.length > 0) {
                    jokiContainer.innerHTML = data.recentJoki.map(jk => `
                        <div class="bg-black/30 border border-white/5 p-2 rounded-xl text-[10px] space-y-1">
                            <div class="flex justify-between font-mono font-bold">
                                <span class="text-white">${jk.order_id}</span>
                                <span class="text-cyan-400 uppercase font-bold">${jk.order_status}</span>
                            </div>
                            <div class="text-slate-400 truncate">${jk.game_name} (${jk.service_name || 'Push Rank'})</div>
                            ${jk.current_rank && jk.target_rank ? `<div class="text-amber-300 font-mono text-[9px]">🎯 ${jk.current_rank} ➔ ${jk.target_rank}</div>` : ''}
                            <button type="button" onclick="insertCanned('Mengenai pesanan joki Anda #${jk.order_id}: ')" class="text-[9px] text-cyan-400 hover:underline pt-0.5">Kutip ke Chat ↗</button>
                        </div>
                    `).join('');
                } else {
                    jokiContainer.innerHTML = '<div class="text-slate-500 text-[10px] text-center py-2">Belum ada pesanan joki.</div>';
                }
            }
        } catch (e) {
            console.error("Drawer load error:", e);
        }
    }
</script>