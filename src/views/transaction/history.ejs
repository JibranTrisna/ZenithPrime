<div class="max-w-6xl mx-auto">
    
    <div class="flex flex-col md:flex-row justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Riwayat Transaksi</h1>
            <p class="text-slate-400 mt-1">Pantau status Top Up game kamu disini.</p>
        </div>
        <a href="/history" class="mt-4 md:mt-0 bg-slate-800 hover:bg-slate-700 text-white px-4 py-2 rounded-lg border border-slate-600 transition flex items-center text-sm">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Refresh Status
        </a>
    </div>

    <% if (transactions.length === 0) { %>
        
        <div class="bg-slate-800 rounded-2xl p-12 text-center border border-dashed border-slate-700">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-slate-700 rounded-full mb-6">
                <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Belum ada transaksi</h3>
            <p class="text-slate-400 mb-6 max-w-sm mx-auto">Kamu belum pernah melakukan Top Up. Yuk pilih game favoritmu dan mulai belanja!</p>
            <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-xl transition shadow-lg shadow-blue-600/30">
                Mulai Belanja
            </a>
        </div>

    <% } else { %>

        <div class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-900/50 text-slate-400 uppercase text-xs tracking-wider">
                            <th class="p-6 font-medium">Order ID / Tanggal</th>
                            <th class="p-6 font-medium">Detail Game</th>
                            <th class="p-6 font-medium">Total Harga</th>
                            <th class="p-6 font-medium">Status</th>
                            <th class="p-6 font-medium text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                        <% transactions.forEach(trx => { %>
                            <tr class="hover:bg-slate-700/30 transition duration-150">
                                
                                <td class="p-6 align-top">
                                    <div class="font-mono text-sm text-blue-400 font-bold mb-1">
                                        #<%= trx.order_id %>
                                    </div>
                                    <div class="text-xs text-slate-400">
                                        <%= new Date(trx.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                </td>

                                <td class="p-6 align-top">
                                    <div class="flex items-center">
                                        <div class="hidden sm:block w-10 h-10 bg-slate-700 rounded-lg mr-3 overflow-hidden">
                                             <div class="w-full h-full flex items-center justify-center text-xs font-bold text-slate-500">
                                                <%= trx.game_name.substring(0,2).toUpperCase() %>
                                             </div>
                                        </div>
                                        <div>
                                            <div class="text-white font-bold"><%= trx.game_name %></div>
                                            <div class="text-sm text-slate-300"><%= trx.item_name %></div>
                                            <div class="text-xs text-slate-500 mt-1">ID: <%= trx.target_id %></div>
                                        </div>
                                    </div>
                                </td>

                                <td class="p-6 align-top">
                                    <div class="text-white font-medium">
                                        <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(trx.amount) %>
                                    </div>
                                </td>

                                <td class="px-6 py-4">
                                    <% if (trx.status === 'success') { %>
                                        <span class="bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full text-xs font-bold">
                                            PAID / LUNAS
                                        </span>
                                    <% } else if (trx.status === 'pending') { %>
                                        <span class="bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 px-3 py-1 rounded-full text-xs font-bold">
                                            PENDING
                                        </span>
                                    <% } else { %>
                                        <span class="bg-red-500/10 text-red-400 border border-red-500/20 px-3 py-1 rounded-full text-xs font-bold">
                                            FAILED
                                        </span>
                                    <% } %>
                                </td>

                                <td class="px-6 py-4">
                                    <% if (trx.status === 'pending') { %>
                                        <button onclick="snap.pay('<%= trx.snap_token %>')" class="bg-cyan-600 hover:bg-cyan-500 text-white px-4 py-2 rounded-lg text-xs font-bold transition">
                                            Bayar Sekarang
                                        </button>
                                    <% } else if (trx.status === 'success') { %>
                                        <a href="/history/detail/<%= trx.order_id %>" class="text-slate-400 hover:text-white text-xs underline">
                                            Lihat Invoice
                                        </a>
                                    <% } else { %>
                                        <span class="text-slate-600 text-xs">Dibatalkan</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>