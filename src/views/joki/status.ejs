<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6">

    <!-- Breadcrumb & Back -->
    <div class="flex items-center justify-between gap-4 mb-6 text-xs text-slate-400">
        <div class="flex items-center gap-2">
            <a href="/joki" class="hover:text-cyan-400 transition flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                <span>Katalog Joki</span>
            </a>
            <span>/</span>
            <a href="/history" class="hover:text-cyan-400 transition">Riwayat</a>
            <span>/</span>
            <span class="text-white font-semibold font-mono"><%= order.order_id %></span>
        </div>

        <button onclick="window.location.reload()" title="Refresh Status" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-cyan-300 text-xs font-semibold transition group">
            <svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            <span>Perbarui Status</span>
        </button>
    </div>

    <!-- Main Status Card -->
    <div class="rounded-3xl bg-[#121217] border border-white/10 p-6 sm:p-8 shadow-2xl relative overflow-hidden mb-8">
        <div class="absolute -right-10 -top-10 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Top Header & Current Badge -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6 mb-8">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-2xl overflow-hidden border border-white/10 shrink-0 bg-black/40 p-1">
                    <img src="/images/games/<%= order.game_thumbnail %>" alt="<%= order.game_name %>" class="w-full h-full object-cover rounded-xl" onerror="this.src='/images/ZenithPrimeLogoTransparant.png'">
                </div>
                <div>
                    <span class="text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase block">Order Joki Verified</span>
                    <h1 class="text-xl sm:text-2xl font-black text-white"><%= order.service_name %></h1>
                    <div class="text-xs text-slate-400 mt-0.5"><%= order.game_name %> • <%= order.quantity %>x Bintang/Tier</div>
                </div>
            </div>

            <div>
                <% if (order.payment_status !== 'success') { %>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-yellow-500/15 border border-yellow-500/30 text-yellow-300 text-xs font-bold">
                        <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
                        Menunggu Pembayaran
                    </span>
                <% } else if (order.order_status === 'queued') { %>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-blue-500/15 border border-blue-500/30 text-blue-300 text-xs font-bold">
                        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
                        Dalam Antrian Penjoki
                    </span>
                <% } else if (order.order_status === 'in_progress') { %>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 text-xs font-bold animate-pulse">
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                        Sedang Dikerjakan Worker
                    </span>
                <% } else if (order.order_status === 'completed') { %>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold">
                        <span>✓</span> Selesai Penuh 🎉
                    </span>
                <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-red-500/15 border border-red-500/30 text-red-300 text-xs font-bold">
                        Dibatalkan
                    </span>
                <% } %>
            </div>
        </div>

        <!-- 4-STEP VISUAL TIMELINE PROGRESS TRACKER -->
        <div class="mb-10">
            <h3 class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-6">Tahapan Pengerjaan Joki</h3>
            
            <% 
                // Determine active step index: 1 (Payment), 2 (Queued), 3 (In Progress), 4 (Completed)
                let currentStep = 1;
                if (order.payment_status === 'success') {
                    if (order.order_status === 'queued') currentStep = 2;
                    else if (order.order_status === 'in_progress') currentStep = 3;
                    else if (order.order_status === 'completed') currentStep = 4;
                }
            %>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 relative">
                <!-- Step 1: Payment -->
                <div class="p-4 rounded-2xl border transition-all <%= currentStep >= 1 ? (currentStep > 1 ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-cyan-500/15 border-cyan-500/50 text-cyan-300') : 'bg-white/[0.02] border-white/5 text-slate-500' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="w-7 h-7 rounded-xl flex items-center justify-center font-bold text-xs <%= currentStep > 1 ? 'bg-emerald-500 text-black' : (currentStep === 1 ? 'bg-cyan-500 text-black' : 'bg-white/10 text-white') %>">
                            <%= currentStep > 1 ? '✓' : '1' %>
                        </span>
                        <span class="text-[10px] font-mono"><%= order.payment_status === 'success' ? 'LUNAS' : 'PENDING' %></span>
                    </div>
                    <div class="text-white font-bold text-xs mb-0.5">Pembayaran</div>
                    <div class="text-[11px] text-slate-400">Verifikasi otomatis via Midtrans</div>
                </div>

                <!-- Step 2: Queued -->
                <div class="p-4 rounded-2xl border transition-all <%= currentStep >= 2 ? (currentStep > 2 ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-cyan-500/15 border-cyan-500/50 text-cyan-300') : 'bg-white/[0.02] border-white/5 text-slate-500' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="w-7 h-7 rounded-xl flex items-center justify-center font-bold text-xs <%= currentStep > 2 ? 'bg-emerald-500 text-black' : (currentStep === 2 ? 'bg-cyan-500 text-black' : 'bg-white/10 text-white') %>">
                            <%= currentStep > 2 ? '✓' : '2' %>
                        </span>
                        <span class="text-[10px] font-mono"><%= currentStep >= 2 ? 'MASUK ANTRIAN' : 'MENUNGGU' %></span>
                    </div>
                    <div class="text-white font-bold text-xs mb-0.5">Antrian Penjoki</div>
                    <div class="text-[11px] text-slate-400">Pencarian worker pro terbaik</div>
                </div>

                <!-- Step 3: In Progress -->
                <div class="p-4 rounded-2xl border transition-all <%= currentStep >= 3 ? (currentStep > 3 ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-cyan-500/15 border-cyan-500/50 text-cyan-300') : 'bg-white/[0.02] border-white/5 text-slate-500' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="w-7 h-7 rounded-xl flex items-center justify-center font-bold text-xs <%= currentStep > 3 ? 'bg-emerald-500 text-black' : (currentStep === 3 ? 'bg-cyan-500 text-black' : 'bg-white/10 text-white') %>">
                            <%= currentStep > 3 ? '✓' : '3' %>
                        </span>
                        <span class="text-[10px] font-mono"><%= currentStep >= 3 ? 'DIKERJAKAN' : 'MENUNGGU' %></span>
                    </div>
                    <div class="text-white font-bold text-xs mb-0.5">Sedang Dikerjakan</div>
                    <div class="text-[11px] text-slate-400"><%= order.worker_name ? `Penjoki: ${order.worker_name}` : 'Penjoki sedang push rank' %></div>
                </div>

                <!-- Step 4: Completed -->
                <div class="p-4 rounded-2xl border transition-all <%= currentStep >= 4 ? 'bg-emerald-500/15 border-emerald-500/50 text-emerald-300' : 'bg-white/[0.02] border-white/5 text-slate-500' %>">
                    <div class="flex items-center justify-between mb-2">
                        <span class="w-7 h-7 rounded-xl flex items-center justify-center font-bold text-xs <%= currentStep >= 4 ? 'bg-emerald-500 text-black' : 'bg-white/10 text-white' %>">
                            <%= currentStep >= 4 ? '✓' : '4' %>
                        </span>
                        <span class="text-[10px] font-mono"><%= currentStep >= 4 ? 'SELESAI' : 'TARGET' %></span>
                    </div>
                    <div class="text-white font-bold text-xs mb-0.5">Selesai & Bukti</div>
                    <div class="text-[11px] text-slate-400">Screenshot rank final & logout</div>
                </div>
            </div>
        </div>

        <!-- COMPLETION PROOF SCREENSHOT (IF COMPLETED) -->
        <% if (order.order_status === 'completed' && order.proof_image) { %>
            <div class="mb-8 p-6 rounded-3xl bg-emerald-950/20 border border-emerald-500/30">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
                        <span>🏆</span> Bukti Screenshot Hasil Joki (Rank / Bintang Tercapai)
                    </div>
                    <a href="/images/joki-proofs/<%= order.proof_image %>" target="_blank" class="px-3 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/30 text-emerald-300 text-xs font-semibold flex items-center gap-1 transition">
                        <span>Buka Gambar Asli</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                </div>

                <div class="rounded-2xl overflow-hidden border border-white/10 bg-black/60 max-h-96 flex items-center justify-center p-2">
                    <img src="/images/joki-proofs/<%= order.proof_image %>" alt="Bukti Joki" class="max-h-80 w-auto object-contain rounded-xl shadow-2xl">
                </div>

                <% if (order.worker_notes) { %>
                    <div class="mt-4 p-3 rounded-xl bg-white/[0.04] border border-white/5 text-xs text-slate-300">
                        <span class="text-slate-400 font-bold block mb-1">Pesan dari Penjoki:</span>
                        <span class="italic font-mono text-cyan-300">"<%= order.worker_notes %>"</span>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- ORDER INFORMATION GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 space-y-2.5">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Detail Request Joki</div>
                
                <div class="flex justify-between">
                    <span class="text-slate-400">Tipe Request:</span>
                    <span class="text-cyan-400 font-bold uppercase"><%= order.request_type || 'Push Rank' %></span>
                </div>
                <% if (order.current_rank && order.target_rank) { %>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Target Request:</span>
                        <span class="text-white font-bold"><%= order.current_rank %> ➔ <%= order.target_rank %></span>
                    </div>
                <% } %>
                <div class="flex justify-between">
                    <span class="text-slate-400">Mode Pengerjaan:</span>
                    <span class="<%= order.play_mode === 'party' ? 'text-emerald-400' : 'text-cyan-300' %> font-semibold">
                        <%= order.play_mode === 'party' ? '👥 Mabar Party Duo (Tanpa Password)' : '🎮 Joki Akun (Solo Push)' %>
                    </span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Metode Login:</span>
                    <span class="text-white font-bold uppercase text-cyan-400"><%= order.login_via %></span>
                </div>
                <% if (order.play_mode !== 'party') { %>
                    <div class="flex justify-between">
                        <span class="text-slate-400">ID / Username:</span>
                        <span class="text-white font-mono"><%= order.account_id %></span>
                    </div>
                <% } %>
                <% if (order.nickname) { %>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Nickname:</span>
                        <span class="text-white"><%= order.nickname %></span>
                    </div>
                <% } %>
                <div class="flex justify-between">
                    <span class="text-slate-400">WhatsApp Koordinasi:</span>
                    <span class="text-white font-mono"><%= order.whatsapp %></span>
                </div>
                <% if (order.request_hero) { %>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Request Hero:</span>
                        <span class="text-amber-400 font-semibold"><%= order.request_hero %></span>
                    </div>
                <% } %>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 space-y-2.5">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Rincian Transaksi & Jaminan</div>
                
                <div class="flex justify-between">
                    <span class="text-slate-400">Order ID:</span>
                    <span class="text-white font-mono font-bold"><%= order.order_id %></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Waktu Order:</span>
                    <span class="text-white"><%= new Date(order.created_at).toLocaleString('id-ID') %></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Total Biaya:</span>
                    <span class="text-cyan-400 font-bold text-sm font-mono">Rp <%= Number(order.total_amount).toLocaleString('id-ID') %></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Penjoki Bertugas:</span>
                    <span class="text-emerald-400 font-semibold"><%= order.worker_name ? `${order.worker_name} (Verified)` : 'Menunggu Pengambilan' %></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Garansi:</span>
                    <span class="text-white font-semibold">100% Anti-Minus & Safe Login</span>
                </div>
            </div>
        </div>

        <% if (order.notes) { %>
            <div class="mt-4 p-3.5 rounded-2xl bg-white/[0.02] border border-white/5 text-xs text-slate-300">
                <span class="text-slate-400 font-bold">Catatan Pelanggan:</span> <%= order.notes %>
            </div>
        <% } %>

        <!-- ACTION FOOTER -->
        <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
            <% if (order.payment_status === 'pending') { %>
                <a href="/joki/checkout/<%= order.order_id %>" class="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:opacity-90 text-white font-bold text-xs sm:text-sm shadow-lg shadow-cyan-500/20 transition">
                    Lanjut ke Halaman Bayar
                </a>
            <% } %>

            <button onclick="toggleChat()" type="button" class="px-5 py-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 font-bold text-xs sm:text-sm flex items-center gap-2 transition">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span>Tanya CS Seputar Order Ini</span>
            </button>

            <a href="/joki" class="text-xs text-slate-400 hover:text-white transition">
                Kembali ke Katalog Joki
            </a>
        </div>
    </div>

</div>
