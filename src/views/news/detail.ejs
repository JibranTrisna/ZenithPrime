<div class="max-w-4xl mx-auto py-12 px-4">
    
    <a href="/" class="inline-flex items-center text-slate-400 hover:text-white mb-8 transition gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Kembali ke Beranda
    </a>

    <article class="bg-[#18181b] border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
        
        <div class="h-64 w-full bg-gradient-to-r from-indigo-900 to-purple-900 relative flex items-center justify-center">
            <h1 class="text-9xl text-white opacity-5 font-black absolute">NEWS</h1>
            <div class="relative z-10 text-center px-4">
                <span class="inline-block px-3 py-1 mb-4 rounded bg-white/10 border border-white/20 text-white text-xs font-bold tracking-widest backdrop-blur-md">
                    <%= news.type %>
                </span>
                <h1 class="text-3xl md:text-5xl font-extrabold text-white leading-tight">
                    <%= news.title %>
                </h1>
                <p class="text-slate-300 mt-4 font-mono text-sm">
                    Diposting pada: <span class="text-cyan-400"><%= news.full_date %></span>
                </p>
            </div>
        </div>

        <div class="p-8 md:p-12 text-slate-300 leading-relaxed text-lg space-y-6">
            <%- news.content %>
        </div>

        <div class="bg-black/20 p-8 border-t border-white/5 text-center">
            <p class="text-slate-500 text-sm mb-4">Apakah informasi ini membantu?</p>
            <div class="flex justify-center gap-4">
                <a href="/news" class="px-6 py-2 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold transition">
                    Lihat Berita Lainnya
                </a>
                
                <a href="/" class="px-6 py-2 rounded-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold transition shadow-lg shadow-cyan-500/20">
                    Top Up Sekarang
                </a>
            </div>
        </div>

    </article>
</div>